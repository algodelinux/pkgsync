#!/usr/bin/env bash
# -------------------------------------------------------------------------------------------
# script: install-last-available-proxmox-kernels
# Author: Esteban M. Navas Martín
# Date:   23-09-2026
# Ver:    23-09-2026
#
# Purpose: Install the latest N available Proxmox kernels and remove the excess ones  to 
#          maintain a total number of N kernels on the system.
# -------------------------------------------------------------------------------------------

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

is_installed() {
    dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "install ok installed"
}

# 1. Comprobaciones iniciales (permisos y parámetros)
if (( EUID != 0 )); then
   echo -e "${RED}Error: Por favor, ejecute el script con SUDO o como usuario root.${NC}"
   exit 1
fi

if [[ -z "${1:-}" ]] || ! [[ "$1" =~ ^[0-9]+$ ]]; then
    echo -e "${RED}Error: Debe especificar un número entero válido de kernels a mantener.${NC}"
    echo -e "${GREEN}Sintaxis: $0 <numero-de-kernels>${NC}"
    exit 1
fi

numkernels="$1"
CURRENT_KERNEL_VER="$(uname -r)"
KERNEL_FLAVOR="$(echo "$CURRENT_KERNEL_VER" | cut -d'.' -f1,2)"

# 2. Detección automática del tipo de kernel en uso (signed vs no-signed)
USE_SIGNED=false
CURRENT_PKG=$(dpkg -S "/boot/vmlinuz-$CURRENT_KERNEL_VER" 2>/dev/null | cut -d':' -f1 || true)

if [[ "$CURRENT_PKG" == *-signed ]] || is_installed "proxmox-kernel-${CURRENT_KERNEL_VER}-signed"; then
    USE_SIGNED=true
fi

# 3. Obtener los N últimos kernels disponibles según la variante detectada
if [[ "$USE_SIGNED" == true ]]; then
    AVAILABLE_KERNELS=$(
        apt-cache search "^proxmox-kernel-$KERNEL_FLAVOR" \
        | awk '{print $1}' \
        | grep -- "-signed$" \
        | sort -V \
        | tail -n "$numkernels" \
        | sed -E 's/^proxmox-kernel-//; s/-signed$//'
    )
else
    AVAILABLE_KERNELS=$(
        apt-cache search "^proxmox-kernel-$KERNEL_FLAVOR" \
        | awk '{print $1}' \
        | grep -- "-pve$" \
        | sort -V \
        | tail -n "$numkernels" \
        | sed -E 's/^proxmox-kernel-//'
    )
fi

INSTALLED_NEW_IMAGE=false

# 4. Instalación de los N últimos kernels y sus cabeceras
for KERNEL_VERSION in $AVAILABLE_KERNELS; do
    if [[ "$USE_SIGNED" == true ]]; then
        IMAGE_PKG="proxmox-kernel-${KERNEL_VERSION}-signed"
    else
        IMAGE_PKG="proxmox-kernel-${KERNEL_VERSION}"
    fi

    # Instalar la imagen si no está instalada
    if ! is_installed "$IMAGE_PKG"; then
        if apt-cache show "$IMAGE_PKG" &>/dev/null; then
            echo -e "${GREEN}Instalando $IMAGE_PKG...${NC}"
            apt-get -y install "$IMAGE_PKG"
            INSTALLED_NEW_IMAGE=true
        fi
    fi

    # Instalar las cabeceras correspondientes
    HEADER_PKG="proxmox-headers-${KERNEL_VERSION}"
    if ! is_installed "$HEADER_PKG"; then
        if apt-cache show "$HEADER_PKG" &>/dev/null; then
            echo -e "${GREEN}Instalando $HEADER_PKG...${NC}"
            apt-get -y install "$HEADER_PKG"
        fi
    fi
done

# 5. Purgado de kernels antiguos sobrantes
INSTALLED_VERSIONS=$(dpkg-query -W -f='${Package}\t${Status}\n' 'proxmox-kernel-[0-9]*' 2>/dev/null \
    | grep "install ok installed" \
    | awk '{print $1}' \
    | grep -- "-pve" \
    | sed -E 's/^proxmox-kernel-//; s/-signed$//' \
    | sort -V \
    | uniq)

NUM_INSTALLED=$(echo "$INSTALLED_VERSIONS" | sed '/^$/d' | wc -l)

if (( NUM_INSTALLED > numkernels )); then
    EXTRA_COUNT=$(( NUM_INSTALLED - numkernels ))
    echo -e "${YELLOW}Se detectaron $NUM_INSTALLED versiones de kernels instaladas. Se mantendrán solo las $numkernels más recientes.${NC}"

    CANDIDATES_TO_REMOVE=$(echo "$INSTALLED_VERSIONS" | head -n "$EXTRA_COUNT")
    PACKAGES_TO_PURGE=""

    for VERSION_TO_REMOVE in $CANDIDATES_TO_REMOVE; do
        # Seguridad: NUNCA eliminar el kernel actualmente activo
        if [[ "$VERSION_TO_REMOVE" == "$CURRENT_KERNEL_VER" ]]; then
            echo -e "${YELLOW}Aviso: Se omite la versión $VERSION_TO_REMOVE por estar actualmente en uso ($CURRENT_KERNEL_VER).${NC}"
            continue
        fi

        # Añadir a la purga cualquier paquete (firmado, no firmado o cabeceras) perteneciente a esta versión
        for TARGET_PKG in "proxmox-kernel-${VERSION_TO_REMOVE}-signed" \
                          "proxmox-kernel-${VERSION_TO_REMOVE}" \
                          "proxmox-headers-${VERSION_TO_REMOVE}"; do
            if is_installed "$TARGET_PKG"; then
                PACKAGES_TO_PURGE="$PACKAGES_TO_PURGE $TARGET_PKG"
            fi
        done
    done

    if [[ -n "$PACKAGES_TO_PURGE" ]]; then
        echo -e "${GREEN}Eliminando paquetes sobrantes:${NC}$PACKAGES_TO_PURGE"
        apt-get purge -y $PACKAGES_TO_PURGE
        apt-get autoremove --purge -y
    fi
fi

# 6. Reordenación y actualización del cargador de arranque
if [[ "$INSTALLED_NEW_IMAGE" == true ]]; then
    echo
    echo -e "${GREEN}Se ha instalado un nuevo kernel. Ejecutando actualización de arranque...${NC}"
    if [[ -x /usr/local/sbin/reorder-kernels ]]; then
        /usr/local/sbin/reorder-kernels
    elif command -v proxmox-boot-tool &>/dev/null; then
        proxmox-boot-tool refresh
    fi
fi
