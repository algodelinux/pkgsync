#!/bin/bash
#
#    purge-old-kernels - remove old kernel packages
#    Copyright (C) 2012      Dustin Kirkland <kirkland@ubuntu.com>
#                  2017-2026 Esteban M. Navas Martín <algodelinux@gmail.com>
#
#    Authors: Dustin Kirkland <kirkland@ubuntu.com>
#             Kees Cook <kees@ubuntu.com>
#             Esteban M. Navas Martín <algodelinux@gmail.com>
#
#    This program is free software: you can redistribute it and/or modify
#    it under the terms of the GNU General Public License as published by
#    the Free Software Foundation, version 3 of the License.
#
#    This program is distributed in the hope that it will be useful,
#    but WITHOUT ANY WARRANTY; without even the implied warranty of
#    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
#    GNU General Public License for more details.
#
#    You should have received a copy of the GNU General Public License
#    along with this program.  If not, see <http://www.gnu.org/licenses/>.

export VERSION=1.9

SCRIPT="$(basename "$0")"
export DEBIAN_FRONTEND=noninteractive

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
NC='\033[0m'

# Ensure we're running as root
if [ "$(id -u)" != 0 ]; then
	echo -e "${RED}ERROR: This script must run as root.  Hint...${NC}" 1>&2
	echo "  sudo $0 $@" 1>&2
	exit 1
fi

print_version() {
   echo "$SCRIPT $VERSION"
}

print_help () {
   echo "$SCRIPT $VERSION"
   echo "Purge old kernels tool"
   echo ""
   echo "Usage: $SCRIPT [OPTIONS]"
   echo "Recognized options:"
   echo "  -h,  --help                       display this help and exit"
   echo "  -v   --version                    display $SCRIPT version and exit"
   echo "  -s,  --show-installed-kernels     display installed kernels (and continue)"
   echo "  -k,  --keep N                     keep last N kernels"
   echo "                                    ALWAYS keep the currently running kernel"
   echo "  -n,  --no-rm-modules              don't remove non installed kernels directories in /lib/modules"
   echo "  -q,  --quiet                      pass -q option to apt-get"
   echo "  -y,  --yes                        pass -y option to apt-get"
   echo "  -o,  --option                     pass extra options to apt-get"
   echo "       --dry-run                    show what would be purged without doing it"
   echo
}

# Run apt-get (or only show it in dry-run mode)
run_apt() {
   if [ "$DRY_RUN" = true ]; then
      echo -e "${YELLOW}[DRY-RUN] apt-get $APT_OPTS $*${NC}"
   else
      # shellcheck disable=SC2086
      apt-get $APT_OPTS "$@"
   fi
}

parse_options() {
   TEMP=$(getopt -o hvsk:qyno: --long help,version,show-installed-kernels,keep:,quiet,yes,no-rm-modules,option,dry-run -n 'purge-old-kernels' -- "$@")

   if [ $? != 0 ] ; then echo "Terminating..." >&2 ; exit 1 ; fi

   eval set -- "$TEMP"

   while true; do
     case "$1" in
       -h | --help)
                 print_help
                 exit 0
                 ;;
       -v | --version)
                 print_version
                 exit 0
                 ;;
       -s | --show-installed-kernels )
                 SHOW_INSTALLED=true
                 shift
                 ;;
       -n | --no-rm-modules )
                 NO_RM_MODULES=true
                 shift
                 ;;
       -k | --keep )
                 KEEP="$2"
                 shift 2
                 ;;
       -q | --quiet )
                 APT_OPTS="$APT_OPTS -q"
                 shift 1
                 ;;
       -y | --yes )
                 APT_OPTS="$APT_OPTS -y"
                 shift 1
                 ;;
       -o | --option )
                 APT_OPTS="$APT_OPTS -o $2"
                 shift 2
                 ;;
       --dry-run )
                 DRY_RUN=true
                 shift
                 ;;
       -- )
                 shift
                 break
                 ;;
       * )
                 echo "Internal error: doesn't recognize argument '$1'"
                 exit 1
                 ;;
     esac
   done
}

# Given a kernel package name, print its version string (with flavour)
version_of_pkg() {
   local v="$1"
   case "$v" in
      linux-image-unsigned-*) v="${v#linux-image-unsigned-}" ;;
      linux-image-*)          v="${v#linux-image-}" ;;
      proxmox-kernel-*)       v="${v#proxmox-kernel-}" ;;
   esac
   echo "$v"
}

# Installed kernel packages (iI/iF/iU/hi...): from dpkg, not from /boot,
# so kernels in a half-configured state or without their vmlinuz file in
# /boot are still seen and can be purged.
get_installed_kernel_pkgs() {
   dpkg-query -W -f='${binary:Package}\t${db:Status-Abbrev}\n' 2>/dev/null |
      awk -F'\t' '$1 ~ /^(linux-image(-unsigned)?|proxmox-kernel)-[0-9]/ && $2 ~ /^[rph ]*i/ {print $1}' |
      sort -u
}

show_installed_kernels () {
   local pkg v
   echo -e "Installed kernels (from dpkg):"
   while IFS= read -r pkg; do
      [ -n "$pkg" ] || continue
      v=$(version_of_pkg "$pkg")
      if [ "$v" = "$RUNNING_KERNEL" ]; then
         echo -e "  ${BLUE}$v [running]${NC}"
      else
         echo "  $v"
      fi
   done < <(get_installed_kernel_pkgs | while IFS= read -r p; do version_of_pkg "$p"; done | sort -uV)
   echo -e "Running kernel: ${GREEN}$RUNNING_KERNEL${NC}"
}

clean_old_kernel_modules() {
    # $1 = keep list (kernel versions whose /lib/modules dir must be kept)

    # Si no hay PVE kernel, y tenemos una lista de kernels instalados fiable,
    # eliminamos los directorios de /lib/modules que no correspondan a
    # ningún kernel instalado (ni al que está en ejecución)
    if [ -z "$PVE_KERNEL" ] && [ "$NO_RM_MODULES" = false ] && [ -n "$1" ]; then
        local keep_args=()
        local k
        for k in $1; do
           keep_args+=(-not -name "$k")
        done

        if [ "$DRY_RUN" = true ]; then
           find /lib/modules -mindepth 1 -maxdepth 1 -type d "${keep_args[@]}" 2>/dev/null
        else
           find /lib/modules -mindepth 1 -maxdepth 1 -type d "${keep_args[@]}" -exec rm -rf {} + 2>/dev/null || true
        fi
    fi
}


# NOTE: This script will ALWAYS keep the currently running kernel
# NOTE: Default is to keep 2 kernels in total (running one included),
#       user overrides with --keep N
KEEP=2
APT_OPTS=
NO_RM_MODULES=false
DRY_RUN=false
SHOW_INSTALLED=false
PURGE=""

parse_options "$@"

if ! [[ "$KEEP" =~ ^[1-9][0-9]*$ ]]; then
   echo -e "${RED}ERROR: --keep must be a positive integer (got '$KEEP')${NC}" >&2
   exit 1
fi

RUNNING_KERNEL=$(uname -r)

# Get kernel type: pve or not
PVE_KERNEL=$(echo "$RUNNING_KERNEL" | grep pve)

if [ "$SHOW_INSTALLED" = true ]; then
   show_installed_kernels
fi

echo "We keep last $KEEP installed kernels (including the running one)"

# Installed kernels according to dpkg: the source of truth.
# (v1.8 derived candidates from the vmlinuz-* files in /boot; when a kernel
# had no vmlinuz there - half-configured after a failed postinst, manual
# cleanup... - it was invisible to the script and NOTHING was purged.)
INSTALLED_KERNEL_PKGS="$(get_installed_kernel_pkgs)"

if [ -z "$INSTALLED_KERNEL_PKGS" ]; then
   echo -e "${YELLOW}No installed kernel packages found via dpkg-query; nothing to do.${NC}"
   exit 0
fi

ALL_VERSIONS=$(for pkg in $INSTALLED_KERNEL_PKGS; do version_of_pkg "$pkg"; done | sort -uV)

# Kernels to keep: EXACTLY $KEEP kernels total, ALWAYS including the
# running one. If the running kernel is not among the newest $KEEP, it
# takes one of those slots (the oldest of the newest $KEEP is dropped);
# no extra kernels are kept.
NEWEST_VERSIONS=$(echo "$ALL_VERSIONS" | tail -n "$KEEP")
if echo "$NEWEST_VERSIONS" | grep -qxF "$RUNNING_KERNEL"; then
   KEEP_VERSIONS="$NEWEST_VERSIONS"
else
   KEEP_VERSIONS=$( { [ "$KEEP" -gt 1 ] && echo "$NEWEST_VERSIONS" | tail -n $((KEEP-1)); echo "$RUNNING_KERNEL"; } | sort -uV)
fi

# Candidates: installed versions not in the keep set
CANDIDATES=""
for v in $ALL_VERSIONS; do
   echo "$KEEP_VERSIONS" | grep -qxF "$v" || CANDIDATES="$CANDIDATES$v
"
done

# Full list of installed linux/proxmox packages (single dpkg-query pass)
ALL_PKGS=$(dpkg-query -W -f='${binary:Package}\n' 2>/dev/null | grep -E '^(linux|proxmox)-' | sort -u)

series_purged=""
for c in $CANDIDATES; do
   [ -n "$c" ] || continue
   escaped_c=$(printf '%s\n' "$c" | sed 's/[][().^$*+?{}|]/\\&/g')
   # All packages belonging to that kernel version: image, headers, modules,
   # modules-extra, tools, buildinfo, hwe-headers/tools, dkms modules per-kernel...
   PURGE="$PURGE $(echo "$ALL_PKGS" | grep -E "^(linux|proxmox)-.*-$escaped_c$" | tr "\n" " ")"

   # Also packages of that version without flavour suffix (linux-hwe-x.y-headers/tools-z)
   base_c=$(echo "$c" | sed -E 's/-[a-z0-9.]+$//')
   escaped_base=$(printf '%s\n' "$base_c" | sed 's/[][().^$*+?{}|]/\\&/g')
   PURGE="$PURGE $(echo "$ALL_PKGS" | grep -E "^linux-hwe-.*-${escaped_base}$" | tr "\n" " ")"

   # If after this purge no kernel of series x.y remains installed,
   # also purge the series meta packages (linux-hwe-x.y-*, proxmox-kernel-x.y)
   SERIES=$(echo "$c" | cut -d. -f1-2)
   if ! echo "$series_purged" | grep -qxF "$SERIES"; then
      escaped_series=$(printf '%s\n' "$SERIES" | sed 's/[.]/\\&/g')
      remaining_in_series=$({ echo "$ALL_VERSIONS"; echo "$RUNNING_KERNEL"; } |
         grep -E "^${escaped_series}\." | grep -vxF -f <(echo "$CANDIDATES") || true)
      if [ -z "$remaining_in_series" ]; then
         if echo "$c" | grep -q pve; then
            PURGE="$PURGE $(echo "$ALL_PKGS" | grep -E "^proxmox-(kernel|headers)-${escaped_series}\$" | tr "\n" " ")"
         else
            PURGE="$PURGE $(echo "$ALL_PKGS" | grep -E "^linux-hwe-${escaped_series}-" | tr "\n" " ")"
         fi
         series_purged="$series_purged$SERIES
"
      fi
   fi
done

# Removed packages with configuration files (RC)
RC_PKGS=$(dpkg-query -W -f='${binary:Package}\t${db:Status-Abbrev}\n' 2>/dev/null |
   awk -F'\t' '$2 ~ /^r/ && $1 ~ /^(proxmox-(kernel|headers)|linux-.*(image|headers|modules)|linux-hwe.*(image|headers|modules|tools|headers))/ {print $1}')

# Purge rc (config files of uninstalled kernels)
if [ -n "$RC_PKGS" ]; then
   # shellcheck disable=SC2086
   run_apt purge $(echo $RC_PKGS)
fi

if [ -z "$PURGE" ]; then
   echo "No kernels are eligible for removal"
   exit 0
fi

[ -n "$RC_PKGS" ] && echo -e "${YELLOW}Purging rc kernel packages too.${NC}"

# Deduplicate the purge list
PURGE=$(echo $PURGE | tr ' ' '\n' | sed '/^$/d' | sort -u | tr '\n' ' ')

# Purge old installed kernels
# shellcheck disable=SC2086
run_apt remove --purge $(echo $PURGE)

# Clean module directories that no longer belong to any installed kernel
MODULES_KEEP_LIST="$ALL_VERSIONS
$RUNNING_KERNEL"
clean_old_kernel_modules "$MODULES_KEEP_LIST"