#!/usr/bin/env python3
import os
import sys
import re
import glob
import urllib.request
import subprocess

KEYSERVER_URL = "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x{key_id}"

def normalize_uri(uri):
    """Normaliza la URI para facilitar la coincidencia."""
    uri = uri.strip().rstrip('/')
    uri = re.sub(r'^https?://', '', uri)
    # Ubuntu usa indistintamente ppa.launchpadcontent.net y ppa.launchpad.net
    return uri.replace('ppa.launchpadcontent.net', 'ppa.launchpad.net')

def parse_deb822_sources():
    """Analiza los archivos .sources en /etc/apt/sources.list.d/"""
    uri_to_signedby = {}
    sources_files = glob.glob("/etc/apt/sources.list.d/*.sources")

    for filepath in sources_files:
        with open(filepath, 'r', encoding='utf-8', errors='ignore') as f:
            current_stanza = {}
            for line in f:
                line_str = line.strip()
                if not line_str or line_str.startswith('#'):
                    if current_stanza:
                        process_stanza(current_stanza, uri_to_signedby)
                        current_stanza = {}
                    continue
                if ':' in line_str:
                    k, v = line_str.split(':', 1)
                    current_stanza[k.strip().lower()] = v.strip()
            if current_stanza:
                process_stanza(current_stanza, uri_to_signedby)
                
    return uri_to_signedby

def process_stanza(stanza, uri_map):
    uris = stanza.get('uris', '')
    signed_by = stanza.get('signed-by', '')
    if uris and signed_by and signed_by.startswith('/'):
        for u in uris.split():
            uri_map[normalize_uri(u)] = signed_by

def parse_traditional_lists():
    """Soporte secundario para archivos .list tradicionales con [signed-by=...]"""
    uri_to_signedby = {}
    list_files = glob.glob("/etc/apt/sources.list.d/*.list")
    if os.path.exists("/etc/apt/sources.list"):
        list_files.append("/etc/apt/sources.list")

    for filepath in list_files:
        with open(filepath, 'r', encoding='utf-8', errors='ignore') as f:
            for line in f:
                line_str = line.strip()
                if line_str.startswith('#') or not line_str.startswith('deb'):
                    continue
                sb_match = re.search(r'\[.*signed-by=([^\s\]]+).*\]', line_str)
                if sb_match:
                    sb_path = sb_match.group(1)
                    clean_line = re.sub(r'\[.*?\]', '', line_str)
                    parts = clean_line.split()
                    if len(parts) >= 2:
                        uri_map_key = normalize_uri(parts[1])
                        uri_to_signedby[uri_map_key] = sb_path
    return uri_to_signedby

def fetch_and_save_key(key_id, target_path):
    """Descarga la clave y la guarda en la ruta indicada convirtiendo a binario si es .gpg"""
    os.makedirs(os.path.dirname(target_path), exist_ok=True)
    url = KEYSERVER_URL.format(key_id=key_id)
    
    try:
        req = urllib.request.Request(url, headers={'User-Agent': 'launchpad-getkeys/2.0'})
        with urllib.request.urlopen(req) as response:
            ascii_key = response.read()

        if not ascii_key or b"BEGIN PGP PUBLIC KEY BLOCK" not in ascii_key:
            print(f"  ✗ No se pudo obtener la clave {key_id} desde el servidor.")
            return False

        # Si el destino termina en .gpg, se convierte a binario OpenPGP con gpg --dearmor
        if target_path.endswith('.gpg'):
            proc = subprocess.run(
                ["gpg", "--dearmor", "-o", target_path],
                input=ascii_key,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=True
            )
        else:
            # Si termina en .asc o similar, se guarda en ASCII
            with open(target_path, 'wb') as f:
                f.write(ascii_key)

        os.chmod(target_path, 0o644)
        print(f"  ✓ Clave {key_id} guardada con éxito en: {target_path}")
        return True

    except Exception as e:
        print(f"  ✗ Error al procesar la clave {key_id}: {e}")
        return False

def main():
    if os.geteuid() != 0:
        print("Error: Este script debe ejecutarse con sudo o como root.", file=sys.stderr)
        sys.exit(1)

    print("Obteniendo mapa de archivos Signed-By en los repositorios...")
    repo_map = parse_deb822_sources()
    repo_map.update(parse_traditional_lists())

    print("Ejecutando apt-get update para detectar claves faltantes...")
    res = subprocess.run(["apt-get", "update"], capture_output=True, text=True, env={**os.environ, "LC_ALL": "C"})

    # Extrae pares (URI_del_error, KEY_ID)
    matches = re.findall(r'GPG error:\s+(\S+)\s+\S+\s+InRelease:.*NO_PUBKEY\s+([0-9A-Fa-f]+)', res.stderr + res.stdout)

    if not matches:
        print("No se encontraron errores NO_PUBKEY en los repositorios.")
        sys.exit(0)

    processed_keys = set()

    for uri, key_id in matches:
        if key_id in processed_keys:
            continue

        norm_uri = normalize_uri(uri)
        target_path = repo_map.get(norm_uri)

        if target_path:
            print(f"\nProcesando clave {key_id} para {uri}:")
            fetch_and_save_key(key_id, target_path)
            processed_keys.add(key_id)
        else:
            # Ruta de respaldo si el repositorio no declara un Signed-By explícito
            fallback_path = f"/etc/apt/keyrings/launchpad-{key_id}.gpg"
            print(f"\nAdvertencia: No se encontró Signed-By explícito para {uri}.")
            print(f"Usando ruta de respaldo: {fallback_path}")
            fetch_and_save_key(key_id, fallback_path)
            processed_keys.add(key_id)

if __name__ == "__main__":
    main()
