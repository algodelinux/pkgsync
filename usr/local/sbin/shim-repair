#!/bin/bash
# ==============================================================================
# Purpose: Manages shim-signed and GRUB EFI bootloader packages based on UEFI
# support and EFI System Partition (ESP) availability.
#
# Date:     2026-10-07 (Fixed: 2026-11-12)
#
# 2026      Esteban M. Navas Martín <algodelinux@gmail.com>.
# ==============================================================================

get_esp_partition() {
    # Priorizar la partición ya montada en /boot/efi si existe
    local mounted_esp
    mounted_esp=$(findmnt -rn -M /boot/efi -o SOURCE 2>/dev/null | head -n 1)
    if [ -n "$mounted_esp" ] && [ -b "$mounted_esp" ]; then
        echo "$mounted_esp"
        return 0
    fi

    # Buscar por GUID estándar de partición EFI System Partition (ESP)
    lsblk -rpno NAME,PARTTYPE 2>/dev/null |
        awk 'tolower($2) == "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" {
            print $1
            exit
        }'
}

get_disk_by_id() {
    local target_real
    target_real=$(readlink -f "$1")
    local link

    for link in /dev/disk/by-id/*-part*; do
        [ -e "$link" ] || continue
        if [ "$(readlink -f "$link")" = "$target_real" ]; then
            echo "$link"
            return 0
        fi
    done

    # Fallback al dispositivo directo si no existe enlace en /dev/disk/by-id
    echo "$1"
}

update_grub_debconf() {
    local efi_device="$1"
    local owners

    # Obtener propietarios actuales de grub-efi/install_devices en debconf + habituales
    owners=$(
        {
            awk '/^Name: grub-efi\/install_devices$/{f=1; next} f && /^Owners:/{gsub(/,/," "); for(i=2;i<=NF;i++) print $i; f=0}' /var/cache/debconf/config.dat 2>/dev/null
            printf '%s\n' "grub-efi-amd64" "grub-pc" "grub-efi-amd64-signed"
        } | sort -u
    )

    for owner in $owners; do
        debconf-set-selections <<EOF
$owner grub-efi/install_devices multiselect $efi_device
$owner grub-efi/install_devices_empty boolean false
EOF
    done
}

is_pkg_installed() {
    local status
    status=$(dpkg-query -W -f='${Status}' "$1" 2>/dev/null)
    [ "$status" = "install ok installed" ]
}

install_shim_if_uefi() {
    local EFI_PARTITION EFI_MOUNTPOINT EFI_PARENT EFI_DISK EFI_BY_ID

    EFI_PARTITION=$(get_esp_partition)

    # Si no hay partición EFI (sistema Legacy/BIOS)
    if [ -z "$EFI_PARTITION" ]; then
        echo "Sistema no UEFI (sin partición ESP)."

        if is_pkg_installed "shim-signed"; then
            echo "'shim-signed' está instalado pero no hay ESP. Procediendo a desinstalar..."
            export DEBIAN_FRONTEND=noninteractive
            apt-get remove --purge -y --allow-remove-essential shim-signed grub-efi-amd64-signed mokutil || true
            apt-get autoremove -y
            unset DEBIAN_FRONTEND
            echo "✔ 'shim-signed' desinstalado correctamente."
        else
            echo "✔ 'shim-signed' no está instalado. No se realiza ninguna acción."
        fi
        return 0
    fi

    # Si shim-signed y grub-efi-amd64-signed ya están completamente instalados y configurados
    if is_pkg_installed "shim-signed" && is_pkg_installed "grub-efi-amd64-signed"; then
        echo "'shim-signed' ya está instalado correctamente. No se realizará ninguna acción."
        return 0
    fi

    # Asegurar que la partición EFI esté montada
    EFI_MOUNTPOINT=$(findmnt -rn -S "$EFI_PARTITION" -o TARGET 2>/dev/null | head -n 1)
    if [ -z "$EFI_MOUNTPOINT" ]; then
        EFI_MOUNTPOINT="/boot/efi"
        mkdir -p "$EFI_MOUNTPOINT"
        if ! mount "$EFI_PARTITION" "$EFI_MOUNTPOINT"; then
            echo "✖ ERROR: No se pudo montar la partición EFI ($EFI_PARTITION) en $EFI_MOUNTPOINT." >&2
            return 1
        fi
    fi

    # Obtener el disco padre de la partición EFI
    EFI_PARENT=$(lsblk -no PKNAME "$EFI_PARTITION" 2>/dev/null | head -n 1)
    if [ -n "$EFI_PARENT" ]; then
        EFI_DISK="/dev/$EFI_PARENT"
    else
        EFI_DISK="$EFI_PARTITION"
    fi

    echo "Disco EFI detectado: $EFI_DISK (Partición: $EFI_PARTITION montada en $EFI_MOUNTPOINT)"

    # Desmontar posible tmpfs residual en /var/lib/grub/esp de ejecuciones anteriores
    if mountpoint -q /var/lib/grub/esp 2>/dev/null; then
        umount /var/lib/grub/esp || {
            echo "✖ ERROR: No se pudo desmontar /var/lib/grub/esp." >&2
            return 1
        }
    fi

    # Actualizar debconf con el by-id real de la partición EFI actual
    EFI_BY_ID=$(get_disk_by_id "$EFI_PARTITION")
    echo "Actualizando debconf (grub-efi/install_devices) -> $EFI_BY_ID"
    update_grub_debconf "$EFI_BY_ID"

    echo "Ejecutando grub-install en modo no interactivo..."
    if ! grub-install --target=x86_64-efi --efi-directory="$EFI_MOUNTPOINT" --recheck --no-floppy "$EFI_DISK"; then
        echo "⚠ Advertencia: grub-install devolvió un error; se intentará completar vía dpkg/apt." >&2
    fi

    # Configurar paquetes pendientes e instalar shim-signed
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq

    if ! dpkg --configure -a || ! apt-get install -y shim-signed grub-efi-amd64-signed; then
        echo "✖ Falló la instalación o configuración de 'shim-signed'." >&2
        unset DEBIAN_FRONTEND
        return 1
    fi
    unset DEBIAN_FRONTEND

    # Verificación estricta de estado
    if is_pkg_installed "shim-signed" && is_pkg_installed "grub-efi-amd64-signed"; then
        echo "✔ 'shim-signed' y sus dependencias instaladas correctamente."
        return 0
    else
        echo "✖ 'shim-signed' no quedó correctamente configurado." >&2
        return 1
    fi
}

install_shim_if_uefi
