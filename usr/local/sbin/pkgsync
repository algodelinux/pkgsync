#! /bin/bash
#
# pkgsync - Automated package synchronization tool
# 2004-2007 Steinar H. Gunderson <sgunderson@bigfoot.com>.
# 2013-2026 Esteban M. Navas Martín <algodelinux@gmail.com>.
# Last update: 21/11/2026
#

set -e
set -o noglob
export DEBIAN_FRONTEND=noninteractive
export VERSION=3.16

RED='\e[0;31m'
GREEN='\e[0;32m'
YELLOW='\e[0;33m'
CYAN="\033[36m"
NC='\e[0m' # No Color

INFO="${CYAN}[INFO]${NC}"
OK="${GREEN}[✔]${NC}"
WARN="${YELLOW}[!]${NC}"
FAIL="${RED}[✖]${NC}"
LOG="${CYAN}[LOG]${NC}"

log_output_pkgsync() {
    "$@" | tee >(sed -E 's/\x1B\[[0-9;]*[mK]//g' >> /var/log/pkgsync.log)
}

log_output_solve_apt_errors() {
    "$@" | tee >(sed -E 's/\x1B\[[0-9;]*[mK]//g' >> /var/log/solve-apt-errors.log)
}

convert_seconds() {
    local SEGUNDOS=$1

    # Validar que el parámetro sea un número positivo
    if ! [[ $SEGUNDOS =~ ^[0-9]+$ ]]; then
        echo "Error: El parámetro debe ser un número entero positivo."
        return 1
    fi

    if [ "$SEGUNDOS" -eq 0 ]; then
        echo "0 segundos"
        return 0
    fi

    # Calcular los valores
    local DIAS=$(( SEGUNDOS / 86400 ))
    local HORAS=$(( (SEGUNDOS % 86400) / 3600 ))
    local MINUTOS=$(( (SEGUNDOS % 3600) / 60 ))
    local SEGUNDOS_RESTANTES=$(( SEGUNDOS % 60 ))

    # Construir el resultado dinámicamente
    local RESULTADO=""
    [ $DIAS -gt 0 ] && RESULTADO="$RESULTADO$DIAS días, "
    [ $HORAS -gt 0 ] && RESULTADO="$RESULTADO$HORAS horas, "
    [ $MINUTOS -gt 0 ] && RESULTADO="$RESULTADO$MINUTOS minutos, "
    [ $SEGUNDOS_RESTANTES -gt 0 ] && RESULTADO="$RESULTADO$SEGUNDOS_RESTANTES segundos, "

    # Eliminar la última coma y espacio
    RESULTADO=${RESULTADO%, }

    echo "$RESULTADO"
}

print_help () {
	echo "pkgsync $VERSION"
	echo "Automated package synchronization tool"
	echo ""
	echo "Usage: pkgsync [OPTIONS]"
	echo "Recognized options:"
	echo "  -h,   --help                            display this help and exit"
	echo "  -v,   --version                         display pkgsync version and exit"
	echo "  -k,   --keep-unused                     don't remove unused packages"
	echo "  -e,   --ensure-essential                don't remove required, important and standard packages"
	echo "  -s,   --simulate                        simulate and print out which packages would be installed/uninstalled or updated"
	echo "  -t,   --test-files                      test all pkgsync files"
	echo "  -tall --test-files all                  test all pkgsync files"
	echo "  -tmusthave --test-files musthave        test musthave files"
	echo "  -tmayhave --test-files mayhave          test mayhave files"
	echo "  -tmaynothave --test-files maynothave   test maynothave files"
	echo "  -tr,  --test-files r                    test and remove packages from pkgsync files lists"
	echo "  -d,   --delete-files                    delete all pkgsync files"
	echo "  -b,   --build-files                     build musthave and create empty mayhave and maynothave if they don't exist"
	echo "  -f,   --force                           force pkgsync"
	echo "  -c,   --clean                           remove uninstalled packages and clean cache"
	echo "  -C,   --clean-and-purge                 remove uninstalled packages, delete their config files and clean cache"
	echo "  -p,   --purge-old-kernels               remove old kernels keeping the last two (by default)"
	echo "                                          or the number specified in /etc/default/pkgsync file"
	echo "  -n,   --no-sincpuppet                   don't launch sinc_puppet from pkgsync"
	echo "  -i,   --ignore-failed-repos             ignore failed repositories"
	echo "  -g,   --get-keys                        exec launchpad-keys to get repositories keys"
	echo "  -S,   --shutdown                        shutdown machine after pkgsync"
	echo "  -R,   --reboot                          reboot machine after pkgsync"
	echo "  -Rw,  --reboot w                        reboot machine and boot into windows on EFI computers"
	echo ""
	echo "Complete documentation can be found in /usr/share/doc/pkgsync/README.Debian."
}

test_files () {
  set +e
  local IFS=$'\n'
  mkdir -p /var/log/pkgsync
  :>/var/log/pkgsync/removefromlists.log

  local modo="${1:-all}"
  local filtro_modo=()

  case "$modo" in
    musthave)
        filtro_modo=( '(' -name "musthave" -o -name "musthave.ies" -o -path "*/musthave.d/*" ')' )
        ;;
    mayhave)
        filtro_modo=( '(' -name "mayhave" -o -name "mayhave.ies" -o -path "*/mayhave.d/*" ')' )
        ;;
    maynothave)
        filtro_modo=( '(' -name "maynothave" -o -name "maynothave.ies" -o -path "*/maynothave.d/*" ')' )
        ;;
    all)
        filtro_modo=( '(' -name "musthave" -o -name "musthave.ies" -o -path "*/musthave.d/*" \
                      -o -name "mayhave" -o -name "mayhave.ies" -o -path "*/mayhave.d/*" \
                      -o -name "maynothave" -o -name "maynothave.ies" -o -path "*/maynothave.d/*" ')' )
        ;;
    *)
        echo "Error: Mode '$modo' not found. Valid options: all, musthave, mayhave, maynothave." >&2
        set -e
        return 1
        ;;
  esac

  # Ejecución de find inyectando el filtro seleccionado y manteniendo las exclusiones comunes
  for fichero in $(find /etc/pkgsync -type f "${filtro_modo[@]}" -not -name "*.all" -not -name "*.bak*" -not -name "*.[[:digit:]]*"); do
      if [ -s "$fichero" ]; then
         for linea in $(sed '/^[[:blank:]]*#/d;s/#.*//;' "$fichero"); do
            paquete=$(echo "$linea" | awk '{print $1}')

            # Ignorar líneas vacías, meta-paquetes especiales, debtags y expresiones con comodines
            if [ -z "$paquete" ] || [ "$paquete" = "meta:current-kernel" ] || [[ "$paquete" == debtags:* ]] || echo "$paquete" | grep -Eq '[][*?()|~]'; then
               continue
            fi

            if LC_ALL=C apt-cache --quiet=0 policy "$paquete" 2>&1 | tr -d " " | grep -q -e 'Candidate:(none)' -e 'N:Unabletolocatepackage'; then
               echo -e "Package $paquete in file $fichero isn't in repositories" | tee -a /var/log/pkgsync/removefromlists.log
            fi
         done
      fi
  done

  if [ -s /var/log/pkgsync/removefromlists.log ]; then
     echo -e "${GREEN}See /var/log/pkgsync/removefromlists.log${NC}"
  else
     echo -e "${GREEN}No non-existent packages were found.${NC}"
  fi

  set -e
}

delete_files () {
  find /etc/pkgsync/ -not -type d -exec rm -f {} \;
}

remove_packages_from_lists () {
  mkdir -p /var/log/pkgsync
  :>/var/log/pkgsync/removedfromlists.log

  if [ -s /var/log/pkgsync/removefromlists.log ]; then
     local paquete fichero paquete_escaped
     while IFS= read -r linea; do
        # Líneas con el formato:
        #   Package <paquete> in file <fichero> isn't in repositories
        # Un parseo por regex tolera rutas con espacios mejor que cut -d" "
        set -- $(echo "$linea" | sed -n 's/^Package \([^ ]*\) in file \(.*\) isn.t in repositories$/\1 \2/p')
        paquete="$1"; fichero="$2"

        [ -z "$paquete" ] && continue
        [ ! -f "$fichero" ] && continue

        echo -e "Removed package $paquete from file $fichero" | tee -a /var/log/pkgsync/removedfromlists.log

        # Comentamos únicamente la línea que contiene exactamente ese nombre de paquete.
        # IMPORTANTE: usar un delimitador distinto de '|' porque el patrón
        # contiene '|', así sed no puede parsear la expresión (bug corregido).
        paquete_escaped=$(printf '%s\n' "$paquete" | sed 's/[][\\.*^$(){}?+|\/]/\\&/g')
        sed -i -E "s@^([[:blank:]]*)(${paquete_escaped})([[:blank:]]*($|#))@\1#\2\3@" "$fichero"
     done < /var/log/pkgsync/removefromlists.log

     if [ -s /var/log/pkgsync/removedfromlists.log ]; then
       echo -e "${GREEN}See /var/log/pkgsync/removedfromlists.log${NC}"
     else
       echo -e "${GREEN}No packages were found to be removed from lists.${NC}"
     fi
  fi
}

disable_failed_repositories () {
  # Deshabilitamos los repositorios que fallan de /etc/apt/sources.list.d
  if [ -s /tmp/failedrepositories ]; then
     while IFS= read -r repository; do
       [ -z "$repository" ] && continue
       while IFS= read -r failedfilerepository; do
         [ -f "$failedfilerepository" ] && mv -f "$failedfilerepository" "${failedfilerepository}.disabled"
       done < <(find /etc/apt/sources.list.d/ -maxdepth 1 -iname "*.list" -exec grep -F -H "$repository" {} + 2>/dev/null | cut -d: -f1 | sort -u)
     done < /tmp/failedrepositories
  fi
}

enable_repositories () {
  # Habilitamos los repositorios deshabilitados en /etc/apt/sources.list.d
  while IFS= read -r file; do
    [ -f "$file" ] && mv -f "$file" "${file%.disabled}"
  done < <(find /etc/apt/sources.list.d/ -maxdepth 1 -iname "*.disabled" 2>/dev/null)
}

wait_while_locked () {
   if [ -x /usr/local/sbin/wait_for_apt_or_dpkg ]; then
      timeout "$AFTER_TIMEOUT" /usr/local/sbin/wait_for_apt_or_dpkg || true
   else
      # Sin el auxiliar externo también limitamos la espera (evita colgarse
      # indefinidamente si un proceso mantiene el lock para siempre)
      timeout "$AFTER_TIMEOUT" bash -c '
         locks=(/var/lib/apt/lists/lock /var/lib/dpkg/lock /var/lib/dpkg/lock-frontend)
         if lsof "${locks[@]}" >/dev/null 2>&1; then
            echo -e "\033[33mEsperando mientras se actualizan índices o paquetes...\033[0m"
         fi
         while lsof "${locks[@]}" >/dev/null 2>&1; do sleep 1; done
      ' || true
   fi
}

# Largely adapted from /usr/lib/getopt/parse.bash
parse_options () {
	TEMP=$(getopt -o hvft::dbkescCpngiSR:: --long help,version,force,test-files::,delete-files,build-files,keep-unused,ensure-essential,simulate,clean,clean-and-purge,purge-old-kernels,no-sincpuppet,get-keys,ignore-failed-repos,shutdown,reboot:: -n 'pkgsync' -- "$@")

        if [ $? != 0 ] ; then echo -e "${RED}Terminating...${NC}" >&2 ; exit 1 ; fi

	eval set -- "$TEMP"

	APTITUDE_ARGS="-y -q -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold"

	while :; do
		case "$1" in
			-s|--simulate)
                                SIMULATE="yes"
				shift
				;;
			-k|--keep-unused)
				APTITUDE_ARGS="$APTITUDE_ARGS -o Aptitude::Delete-Unused=false"
				shift
				;;
			-e|--ensure-essential)
				ENSURE_ESSENTIAL="yes"
				shift
				;;
			-f|--force)
				FORCE=true
				shift
				;;
			-c|--clean)
				CLEAN="yes"
				shift
				;;
			-C|--clean-and-purge)
				CLEAN="purge"
				shift
				;;
			-p|--purge-old-kernels)
				PURGE_OLD_KERNELS="yes"
				shift
				;;
			-n|--no-sincpuppet)
				LAUNCH_SINC_PUPPET="no"
				shift
				;;
			-g|--get-keys)
				LAUNCHPAD_GETKEYS="yes"
				shift
				;;
			-i|--ignore-failed-repos)
				ABORT_ON_FAILED_REPOS="no"
				shift
				;;
			-S|--shutdown)
				SHUTDOWN=true
				shift
				;;
			-R|--reboot)
				REBOOT=true
                                case "$2" in
                                   "") shift 2 ;;
                                   "w") AUTOMATIC_REBOOT_INTO_WINDOWS=yes; shift 2 ;;
                                   *)  shift 2 ;;
                                esac
				;;
			-t|--test-files)
				local modo="${2:-all}" # Si $2 está vacío, asigna "all"

				case "$modo" in
				   all|musthave|mayhave|maynothave)
				      test_files "$modo"
			              ;;
			           r)
			              test_files
			              remove_packages_from_lists
				      ;;
			          *)
			              echo "Error: Opción '$modo' no reconocida para -t/--test-files" >&2
			              exit 1
 			              ;;
			      esac
			      exit 0
		  	      ;;
			-d|--delete-files)
				delete_files
				exit 0
				;;
			-b|--build-files)
				/usr/local/sbin/musthave-build
				exit 0
				;;
			-h|--help)
				print_help
				exit 0
				;;
			-v|--version)
				echo "$(basename "$0") $VERSION"
				exit 0
				;;
			--)
				shift
				break
				;;
			*)
				echo -e "${RED}Internal error: doesn't recognize argument '$1'${NC}"
				exit 1
				;;
		esac
	done
}

readpkgs () {
	grep -vE '^#' "$1" | grep -vE '^\s*$' | tr -d " \t"
}

getpkgs () {
	local IFS=$'\n'
	for pkg in $( readpkgs "$1" ); do
		# if the line starts with "debtags:", it's a debtags expression,
		# so run it through debtags.
		if echo "$pkg" | grep -Eq '^debtags:'; then
			if ! [ "$USE_DEBTAGS" ]; then
				echo Error: "debtags:" line encountered, but debtags is not installed. Stopping.
				exit 1
			fi
			PATTERN=$( echo "$pkg" | cut -d: -f2- )
			debtags grep "$PATTERN" | tagcoll copy | cut -d: -f1
		else
			# if the line is "meta:current-kernel", use the kernel package
			# for the currently running kernel, if it exists
			if [ "$pkg" = "meta:current-kernel" ]; then
				KVERS=$( uname -r )
				wait_while_locked; aptitude -F '%p' search ".*-image-$KVERS$" | sed "s/ \+$//" 2>/dev/null || true
			else
				# if there's a wildcard in this, push it through aptitude
				# to glob. if not, just print it out.
				if echo "$pkg" | grep -Eq '[][*?()|~]'; then
				   wait_while_locked; aptitude -F '%p' search "$pkg" | sed "s/ \+$//" 2>/dev/null || true
				else
	  			   echo "$pkg"
				fi
			fi
		fi
	done
}

list_essential_packages() {
  # Priorities for build a list of essential packages
  local priority
  for priority in required important standard; do
    dpkg-query -W --showformat='${Package}\t${Priority}\n' | grep "$priority$" | sed "s/\t$priority//g" | sort
  done
}

merge_files() {
  if [ "$ENSURE_ESSENTIAL" = "yes" ]; then
     list_essential_packages > /tmp/essential_packages
  else
     :> /tmp/essential_packages
  fi

  # Merge files
  sort -u -o /etc/pkgsync/musthave.all $MUSTHAVE /etc/pkgsync/musthave.ies $(find /etc/pkgsync/musthave.d -mindepth 1 -maxdepth 1 -type f 2>/dev/null) /tmp/essential_packages
  sort -u -o /etc/pkgsync/maynothave.all $MAYNOTHAVE /etc/pkgsync/maynothave.ies $(find /etc/pkgsync/maynothave.d -mindepth 1 -maxdepth 1 -type f 2>/dev/null)
  sort -u -o /etc/pkgsync/mayhave.all $MAYHAVE /etc/pkgsync/mayhave.ies $(find /etc/pkgsync/mayhave.d -mindepth 1 -maxdepth 1 -type f 2>/dev/null)

  # Remove empty lines, blank spaces, tabs and comments, y reordenar con
  # LC_ALL=C para que comm funcione correctamente
  local f
  for f in /etc/pkgsync/musthave.all /etc/pkgsync/mayhave.all /etc/pkgsync/maynothave.all; do
     sed -i 's/^ *//; s/ *$//; s/^\t*//; s/\t*$//; s/#.*//; /^[[:blank:]]*#/d; /^\s*$/d;' "$f"
     LC_ALL=C sort -u -o "$f" "$f"
  done

  sed 's/^ *//; s/ *$//; s/^\t*//; s/\t*$//; /^[[:blank:]]*#/d; s/#.*//; /^$/d' /etc/pkgsync/musthave.orphan | LC_ALL=C sort -u > /tmp/musthave.orphan.sorted

  # Remove maynothave.all and musthave.orphan packages from musthave.all
  LC_ALL=C comm -23 /etc/pkgsync/musthave.all /tmp/musthave.orphan.sorted > /tmp/musthave.all.tmp
  LC_ALL=C comm -23 /tmp/musthave.all.tmp /etc/pkgsync/maynothave.all > /etc/pkgsync/musthave.all
  rm -f /tmp/musthave.orphan.sorted /tmp/musthave.all.tmp
}

simulate() {

  # En modo simulación NO se lanza sinc_puppet: sería una acción real
  # (ejecuta puppet) en lo que debe ser una pasada de solo lectura.
  # El resto (merge y aptitude -s) no modifica el sistema de paquetes.

  # Merge files
  merge_files

  # Find out what parameters to give to aptitude.
  installed=$( dpkg -l | grep '^ii' | cut -c5- | cut '-d ' -f1 )
  musthave_install=$( getpkgs /etc/pkgsync/musthave.all | sort -u | sed "s/$/+/" )
  maynothave_remove=$( getpkgs /etc/pkgsync/maynothave.all | sort -u | sed "s/$/-/" )
  mayhave_marknonauto=$( getpkgs /etc/pkgsync/mayhave.all | sort -u | sed "s/$/\&m/" )

  # shellcheck disable=SC2086
  log_output_pkgsync run_aptitude full-upgrade -s '?upgradable' $musthave_install $maynothave_remove $mayhave_marknonauto

}

wait_for_sinc_puppet() {
    local timeout_min=$1   # Timeout en minutos
    local timeout_seconds=0
    local elapsed=0
    local pids

    # Convertir minutos a segundos
    if [[ -n "$timeout_min" && "$timeout_min" -gt 0 ]]; then
        timeout_seconds=$((timeout_min * 60))
    fi

    # Comprobar si sinc_puppet está corriendo
    pids=$(pgrep sinc_puppet || true)
    if [[ -n "$pids" ]]; then
        echo -e "${YELLOW}Esperando a que termine sinc_puppet...${NC}"
        runned_sinc_puppet=true
    fi

    # Bucle de espera
    while [[ -n "$pids" ]]; do
        sleep 1
        ((elapsed++)) || true
        pids=$(pgrep sinc_puppet || true)

        if [[ $timeout_seconds -gt 0 && $elapsed -ge $timeout_seconds ]]; then
            if [[ -n "$pids" ]]; then
                echo -e "${RED}Timeout alcanzado esperando a sinc_puppet ($timeout_min min). Matando proceso(s)...${NC}"
                # shellcheck disable=SC2086
                kill -TERM $pids 2>/dev/null || true
                sleep 2
                pids=$(pgrep sinc_puppet || true)
                if [[ -n "$pids" ]]; then
                    echo -e "${RED}Proceso(s) persistente(s), usando kill -KILL...${NC}"
                    # shellcheck disable=SC2086
                    kill -KILL $pids 2>/dev/null || true
                    pids=$(pgrep sinc_puppet || true)
                fi
            fi
            break
        fi
    done

    # Devolver si hubo que esperar
    if [[ "$runned_sinc_puppet" == true ]]; then
        return 0
    else
        return 1
    fi
}

run_aptitude() {

  if [[ "$*" == *full-upgrade* ]]; then
     mkdir -p /var/log/pkgsync
     # No truncamos removefromlists.log aquí: si AUTO_TEST_FILES ya generó
     # resultados, un :> los borraría. Creamos/tocamos el fichero y añadimos.
     touch /var/log/pkgsync/removefromlists.log

     # shellcheck disable=SC2086
     COMMAND="aptitude $APTITUDE_ARGS $*"

     # Bucle para reintentar el comando mientras haya paquetes inexistentes
     retry=1
     while [ $retry -eq 1 ]; do
         echo "RUNNING: $COMMAND"
         # shellcheck disable=SC2086
         wait_while_locked; LC_ALL=C $COMMAND | tee /tmp/apterrors || true

         problematic_package=$(grep -m 1 'Couldn'\''t find any package' /tmp/apterrors | cut -d'"' -f2)

         if [ -n "$problematic_package" ]; then
            echo -e "Package $problematic_package isn't in repositories" | tee -a /var/log/pkgsync/removefromlists.log
            problematic_package_escaped=$(printf '%s\n' "$problematic_package" | sed 's/[][\\.*^$(){}?+|\/]/\\&/g')
            # shellcheck disable=SC2086
            COMMAND=$(echo "$COMMAND" | sed -E "s/(^|[[:space:]])${problematic_package_escaped}[^[:space:]]*/\1/g" | tr -s ' ')
         else
            retry=0
         fi
     done
  else
     # shellcheck disable=SC2086
     echo "RUNNING: aptitude $APTITUDE_ARGS $*"
     # shellcheck disable=SC2086
     wait_while_locked; aptitude $APTITUDE_ARGS "$@"
  fi

  return $?
}

run_debtags() {
  if [ "$USE_DEBTAGS" ]; then
     echo RUNNING: debtags "$@"
     debtags "$@"
  fi
}

# The beautiful look of hacks in the morning...
filter() {
	echo "$@" | tr " " "\n" | sort | uniq -c | grep "     2" | cut -c9-
}

function version_ge() { test "$(echo "$@" | tr " " "\n" | sort -rV | head -n 1)" == "$1"; }

killprocess() {
   # $1 = proceso, $2 = segundos máximos de vida antes de matarlo
   # (antes usaba fechas lstart y comparaba MINUTOS contra lo que le
   # pasaban en SEGUNDOS: un proceso podía vivir horas sin ser matado)
   local pid etime
   pid=$(pgrep -o "$1" 2>/dev/null)
   [ -n "$pid" ] || return 0
   etime=$(ps -o etimes= -p "$pid" 2>/dev/null)
   [ -n "$etime" ] && [ "$etime" -gt "$2" ] && pkill -9 "$1" 2>/dev/null || true
}

# Release y criterio de kernel de nube/GPU: los mecanismos de reparación
# no deben reinstalar kernels de nube, y jamás se toca el kernel en ejecución.
RUNNING_RELEASE=$(uname -r)

is_running_kernel_pkg() { [[ "$1" = *-"$RUNNING_RELEASE" ]]; }

is_cloud_kernel() {
   local pkg="${1%%:*}"
   [[ "$pkg" =~ ^linux-(aws|azure|gcp|oracle|nvidia|iotg|intel-iotg|lowlatency)([-a-z0-9.]*)?$ ]] && return 0
   [[ "$pkg" =~ ^linux-(image|image-unsigned|modules|modules-extra|headers|buildinfo|unsigned)[-a-z0-9.]*-(aws|azure|gcp|oracle|nvidia|iotg|intel-iotg|lowlatency)($|-[0-9][a-z0-9.+-]*)$ ]] && return 0
   return 1
}

check_apt_update() {
    # Umbral en segundos (por defecto 1 día)
    local THRESHOLD_FOR_APT_UPDATE=${THRESHOLD_FOR_APT_UPDATE:-86400}

    # Archivos de caché de apt
    local PKG_CACHE="/var/cache/apt/pkgcache.bin"
    local SRC_CACHE="/var/cache/apt/srcpkgcache.bin"

    # Comprobar cuál existe y tomar el más reciente
    local LATEST_CACHE=""
    if [ -f "$PKG_CACHE" ] && [ -f "$SRC_CACHE" ]; then
        if [ "$PKG_CACHE" -nt "$SRC_CACHE" ]; then
            LATEST_CACHE="$PKG_CACHE"
        else
            LATEST_CACHE="$SRC_CACHE"
        fi
    elif [ -f "$PKG_CACHE" ]; then
        LATEST_CACHE="$PKG_CACHE"
    elif [ -f "$SRC_CACHE" ]; then
        LATEST_CACHE="$SRC_CACHE"
    else
        :> /tmp/failedrepositories
        echo -e "${GREEN}No se encontraron archivos de caché de apt. Ejecutando 'apt-get update'...${NC}"
        LC_ALL=C apt-get update 2>&1 | tee /tmp/apt_update.log | grep '^Err:' | grep -Eo "(http|https)://[a-zA-Z0-9./?=_%-]*" | sort -u > /tmp/failedrepositories || true
        return 0
    fi

    # Calcular antigüedad
    local LAST_UPDATE=$(stat -c %Y "$LATEST_CACHE")
    local CURRENT_TIME=$(date +%s)
    local AGE=$((CURRENT_TIME - LAST_UPDATE))

    # Convertir AGE en días, horas, minutos
    local DAYS=$((AGE / 86400))
    local HOURS=$(((AGE % 86400) / 3600))
    local MINUTES=$(((AGE % 3600) / 60))
    local AGE_HUMAN="${DAYS}d ${HOURS}h ${MINUTES}m"

    # Decidir si ejecutar apt-get update
    if [ "$AGE" -gt "$THRESHOLD_FOR_APT_UPDATE" ]; then
        :> /tmp/failedrepositories
        echo -e "${GREEN}Han pasado ${AGE_HUMAN} desde la última actualización. Ejecutando 'apt-get update'...${NC}"
        LC_ALL=C apt-get update 2>&1 | tee /tmp/apt_update.log | grep '^Err:' | grep -Eo "(http|https)://[a-zA-Z0-9./?=_%-]*" | sort -u > /tmp/failedrepositories || true
    fi
}

unlock_dpkg() {
    local TIME_MINUTES="${1:-5}"
    local FOUND=0
    local PID ETIMES COMM ARGS minutes ACTION_DESC

    log_output_solve_apt_errors echo -e "${CYAN}Buscando procesos dpkg/apt bloqueados o configurando paquetes desde más de $TIME_MINUTES minutos...${NC}"

    while read -r PID ETIMES COMM ARGS; do
        # Solo procesos de gestión de paquetes (falta apt-get y
        # unattended-upgrade, y ambos son habituales en servidores)
        case "$COMM" in
            dpkg|apt|apt-get|unattended-upgrade) ;;
            *) continue ;;
        esac

        minutes=$((10#$ETIMES / 60))

        if [ "$minutes" -ge "$TIME_MINUTES" ]; then
            FOUND=1
            ACTION_DESC="bloqueado"
            [[ "$ARGS" == *"--configure"* ]] && ACTION_DESC="configurando paquetes"

            log_output_solve_apt_errors echo -e "${RED}Proceso $PID ($COMM) $ACTION_DESC lleva $minutes minutos. Terminando...${NC}"

            kill -TERM "$PID" 2>/dev/null || true
            sleep 2
            if ps -p "$PID" > /dev/null 2>&1; then
                log_output_solve_apt_errors echo "Proceso $PID no terminó, forzando KILL..."
                kill -KILL "$PID" 2>/dev/null || true
            fi
        fi
    done < <(ps -eo pid,etimes,comm,args --sort=etimes)

    # Mensaje si no se encontraron procesos
    if [ "$FOUND" -eq 0 ]; then
         log_output_solve_apt_errors echo -e "${GREEN}No se encontraron procesos dpkg/apt bloqueados o configurando paquetes desde más de $TIME_MINUTES minutos.${NC}"
    fi
}

reinstall_broken_dpkg() {
    local INFO_DIR="/var/lib/dpkg/info"
    local BROKEN_PACKAGES=()

    # Obtener todos los paquetes instalados con su arquitectura
    mapfile -t BROKEN_PACKAGES < <(
        dpkg -l | awk '/^ii/ {print $2}' | while IFS= read -r pkg; do
            # Solo corregir wine32:i386 a wine32
            [[ "$pkg" == "wine32:i386" ]] && pkg="wine32"
            # Comprobar si falta el archivo .list
            [ ! -f "$INFO_DIR/$pkg.list" ] && printf '%s\n' "$pkg"
        done
    )

    # Si no hay paquetes rotos, salir silenciosamente
    if [ ${#BROKEN_PACKAGES[@]} -eq 0 ]; then
        return 0
    fi

    # Mostrar paquetes con archivos .list faltantes
    echo "Paquetes con archivos .list faltantes:"
    printf '%s\n' "${BROKEN_PACKAGES[@]}"

    # Reinstalar paquetes automáticamente (sin sudo: el script ya corre como root)
    echo "Reinstalando paquetes..."
    check_apt_update
    wait_while_locked
    apt-get install --reinstall -y "${BROKEN_PACKAGES[@]}" || true
    echo "Reinstalación completada."
}

restore_ldconfig() {
    local TMPDIR="/tmp/libc-bin-restore"
    mkdir -p "$TMPDIR"

    # Comprobación inicial
    if command -v ldconfig >/dev/null 2>&1; then
        rm -rf "$TMPDIR"
        return 0
    fi

    echo -e "$WARN ldconfig no encontrado. Procediendo a restaurarlo..."

    local DISTRO VERSION_ID ARCH REPO PKG_VER PKG_VER_NO_EPOCH PKG_URL PKG_NAME PKG_PATH

    # Detectar distribución y versión
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        DISTRO=${ID,,}
        VERSION_ID=${VERSION_ID:-unknown}
    else
        echo -e "$FAIL No se puede determinar la distribución (falta /etc/os-release)."
        return 1
    fi

    ARCH=$(dpkg --print-architecture)
    echo -e "$INFO Sistema detectado: $DISTRO $VERSION_ID ($ARCH)"

    case "$DISTRO" in
        ubuntu)
            REPO="http://archive.ubuntu.com/ubuntu"
            ;;
        debian)
            REPO="http://deb.debian.org/debian"
            ;;
        *)
            echo -e "$FAIL Distribución no soportada: $DISTRO"
            return 1
            ;;
    esac

    PKG_VER=$(LC_ALL=C apt-cache policy libc-bin 2>/dev/null | awk '/Candidate:/ {print $2}')

    if [ -z "$PKG_VER" ] || [ "$PKG_VER" = "(none)" ]; then
        echo -e "$WARN No se pudo determinar versión de libc-bin con apt-cache, usando fallback..."
        local RELPATH
        RELPATH=$(curl -s "${REPO}/dists/${VERSION_CODENAME:-stable}/main/binary-${ARCH}/Packages.gz" \
                  | gunzip -c 2>/dev/null \
                  | awk '/^Package: libc-bin/{found=1} found && /^Filename:/{print $2; exit}')
        # El índice devuelve una ruta relativa (pool/...): hay que prefijar el repositorio
        [ -n "$RELPATH" ] && PKG_URL="${REPO}/${RELPATH}"
    else
        PKG_VER_NO_EPOCH="${PKG_VER#*:}"
        PKG_URL="${REPO}/pool/main/g/glibc/libc-bin_${PKG_VER_NO_EPOCH}_${ARCH}.deb"
    fi

    if [ -z "$PKG_URL" ]; then
        echo -e "$FAIL No se pudo obtener la URL de libc-bin."
        rm -rf "$TMPDIR"
        return 1
    fi

    PKG_NAME=$(basename "$PKG_URL")
    PKG_PATH="$TMPDIR/$PKG_NAME"

    echo -e "$LOG Descargando $PKG_NAME ..."
    if ! curl -fsSL -o "$PKG_PATH" "$PKG_URL"; then
        echo -e "$FAIL No se pudo descargar $PKG_NAME."
        rm -rf "$TMPDIR"
        return 1
    fi

    # Extraer ldconfig
    echo -e "$INFO Extrayendo paquete..."
    dpkg-deb -x "$PKG_PATH" "$TMPDIR/extracted"

    if [ ! -f "$TMPDIR/extracted/sbin/ldconfig" ]; then
        echo -e "${FAIL}No se encontró ldconfig dentro del paquete descargado."
        rm -rf "$TMPDIR"
        return 1
    fi

    echo -e "${INFO}Copiando ldconfig a /sbin ..."
    cp "$TMPDIR/extracted/sbin/ldconfig" /sbin/ldconfig
    chmod 755 /sbin/ldconfig

    # Verificación y reparación
    echo -e "${INFO}Verificando funcionamiento..."
    if /sbin/ldconfig -p >/dev/null 2>&1; then
        echo -e "$OK ldconfig restaurado correctamente."
    else
        echo -e "$WARN ldconfig copiado pero no parece funcional."
    fi

    echo -e "${INFO}Reinstalando libc-bin y reparando dependencias..."
    wait_while_locked
    apt-get install --reinstall -y libc-bin || true
    wait_while_locked
    apt-get -f install -y || true

    # Limpieza
    echo -e "${INFO}Limpiando archivos temporales..."
    rm -rf "$TMPDIR"

    echo -e "$OK Proceso completado. ldconfig debería estar operativo."
}

get_esp_partition() {
    # Priorizar la partición ya montada en /boot/efi si existe
    local mounted_esp
    mounted_esp=$(findmnt -rn -M /boot/efi -o SOURCE 2>/dev/null | head -n 1)
    if [ -n "$mounted_esp" ] && [ -b "$mounted_esp" ]; then
        echo "$mounted_esp"
        return 0
    fi

    # Buscar por GUID estándar de partición EFI System Partition (ESP)
    lsblk -rpno NAME,PARTTYPE 2>/dev/null |
        awk 'tolower($2) == "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" {
            print $1
            exit
        }'
}

get_disk_by_id() {
    local target_real
    target_real=$(readlink -f "$1")
    local link

    #find sin depender de noglob: con `set -o noglob` el patrón *-part*
    #no se expande y el bucle nunca encontraba los enlaces (bug corregido)
    while IFS= read -r link; do
        [ -e "$link" ] || continue
        if [ "$(readlink -f "$link")" = "$target_real" ]; then
            echo "$link"
            return 0
        fi
    done < <(find /dev/disk/by-id -maxdepth 1 -name '*-part*' 2>/dev/null)

    # Fallback al dispositivo directo si no existe enlace en /dev/disk/by-id
    echo "$1"
}

update_grub_debconf() {
    local efi_device="$1"
    local owner

    for owner in $( {
            awk '/^Name: grub-efi\/install_devices$/{f=1; next} f && /^Owners:/{gsub(/,/," "); for(i=2;i<=NF;i++) print $i; f=0}' /var/cache/debconf/config.dat 2>/dev/null
            printf '%s\n' "grub-efi-amd64" "grub-pc" "grub-efi-amd64-signed"
        } | sort -u ); do
        debconf-set-selections <<EOF
$owner grub-efi/install_devices multiselect $efi_device
$owner grub-efi/install_devices_empty boolean false
EOF
    done
}

is_pkg_installed() {
    local status
    status=$(dpkg-query -W -f='${Status}' "$1" 2>/dev/null)
    [ "$status" = "install ok installed" ]
}

install_shim_if_uefi() {
    local EFI_PARTITION EFI_MOUNTPOINT EFI_PARENT EFI_DISK EFI_BY_ID

    EFI_PARTITION=$(get_esp_partition)

    # Si no hay partición EFI (sistema Legacy/BIOS)
    if [ -z "$EFI_PARTITION" ]; then
        echo "Sistema no UEFI (sin partición ESP)."

        if is_pkg_installed "shim-signed"; then
            echo "'shim-signed' está instalado pero no hay ESP. Procediendo a desinstalar..."
            export DEBIAN_FRONTEND=noninteractive
            apt-get remove --purge -y --allow-remove-essential shim-signed grub-efi-amd64-signed mokutil || true
            apt-get autoremove -y || true
            echo "✔ 'shim-signed' desinstalado correctamente."
        else
            echo "✔ 'shim-signed' no está instalado. No se realiza ninguna acción."
        fi
        return 0
    fi

    # Si shim-signed y grub-efi-amd64-signed ya están completamente instalados y configurados
    if is_pkg_installed "shim-signed" && is_pkg_installed "grub-efi-amd64-signed"; then
        echo "'shim-signed' ya está instalado correctamente. No se realizará ninguna acción."
        return 0
    fi

    # Asegurar que la partición EFI esté montada
    EFI_MOUNTPOINT=$(findmnt -rn -S "$EFI_PARTITION" -o TARGET 2>/dev/null | head -n 1)
    if [ -z "$EFI_MOUNTPOINT" ]; then
        EFI_MOUNTPOINT="/boot/efi"
        mkdir -p "$EFI_MOUNTPOINT"
        if ! mount "$EFI_PARTITION" "$EFI_MOUNTPOINT"; then
            echo "✖ ERROR: No se pudo montar la partición EFI ($EFI_PARTITION) en $EFI_MOUNTPOINT." >&2
            return 1
        fi
    fi

    # Obtener el disco padre de la partición EFI
    EFI_PARENT=$(lsblk -no PKNAME "$EFI_PARTITION" 2>/dev/null | head -n 1)
    if [ -n "$EFI_PARENT" ]; then
        EFI_DISK="/dev/$EFI_PARENT"
    else
        EFI_DISK="$EFI_PARTITION"
    fi

    echo "Disco EFI detectado: $EFI_DISK (Partición: $EFI_PARTITION montada en $EFI_MOUNTPOINT)"

    # Desmontar posible tmpfs residual en /var/lib/grub/esp de ejecuciones anteriores
    if mountpoint -q /var/lib/grub/esp 2>/dev/null; then
        umount /var/lib/grub/esp || {
            echo "✖ ERROR: No se pudo desmontar /var/lib/grub/esp." >&2
            return 1
        }
    fi

    # Actualizar debconf con el by-id real de la partición EFI actual
    EFI_BY_ID=$(get_disk_by_id "$EFI_PARTITION")
    echo "Actualizando debconf (grub-efi/install_devices) -> $EFI_BY_ID"
    update_grub_debconf "$EFI_BY_ID"

    echo "Ejecutando grub-install en modo no interactivo..."
    if ! wait_while_locked; then true; fi
    if ! grub-install --target=x86_64-efi --efi-directory="$EFI_MOUNTPOINT" --recheck --no-floppy "$EFI_DISK"; then
        echo "⚠ Advertencia: grub-install devolvió un error; se intentará completar vía dpkg/apt." >&2
    fi

    # Configurar paquetes pendientes e instalar shim-signed
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq || true
    wait_while_locked

    if ! dpkg --configure -a || ! apt-get install -y shim-signed grub-efi-amd64-signed; then
        echo "✖ Falló la instalación o configuración de 'shim-signed'." >&2
        return 1
    fi

    # Verificación estricta de estado
    if is_pkg_installed "shim-signed" && is_pkg_installed "grub-efi-amd64-signed"; then
        echo "✔ 'shim-signed' y sus dependencias instaladas correctamente."
        return 0
    else
        echo "✖ 'shim-signed' no quedó correctamente configurado." >&2
        return 1
    fi
}

solveapterrors() {
  set +e

  idioma=${LC_ALL:-}
  export LC_ALL=C

  # Matamos procesos detenidos
  stopped_processes=$(ps -eo pid,stat,comm | awk '$2 ~ /^T/ && $3 !~ /^(ps|awk)$/ {print $1}')
  if [ -n "$stopped_processes" ]; then
     # shellcheck disable=SC2086
     kill -9 $stopped_processes 2>/dev/null || true
  fi

  # Esperamos a que termine sinc_puppet o lo matamos si ha transcurrido el timeout
  wait_for_sinc_puppet "$TIMEOUT_FOR_SINC_PUPPET" || true

  # Buscamos procesos dpkg/apt detenidos más de 6 minutos
  unlock_dpkg 6

  # Restauramos ldconfig si no se encuentra
  restore_ldconfig

  # Instalamos shim en sistemas uefi, si se encuentra en estado ^rc
  install_shim_if_uefi

  # Tratamos de instalar paquetes en estado ic
  wait_while_locked; incomplete_packages=$(dpkg -l | awk '/^ic/ {print $2}')
  if [ -n "$incomplete_packages" ]; then
     echo -e "${GREEN}Tratando de reparar paquetes en estado ^ic.${NC}"

     for packagename in $incomplete_packages; do
        wait_while_locked
        if ! run_aptitude -y install "$packagename"; then
           wait_while_locked; dpkg --purge --force-all "$packagename"
        fi
     done
  fi

  # Reinstalamos paquetes en muy mal estado o los desinstalamos si no se pueden reinstalar
  wait_while_locked; very_bad_state_packages=$(dpkg -l | awk '/^.HR/ {print $2}')
  if [ -n "$very_bad_state_packages" ]; then
     echo -e "${GREEN}Tratando de reparar paquetes en muy mal estado.${NC}"

     for packagename in $very_bad_state_packages; do
        # OJO: hay `set -o noglob`, así que "paquete".* NO se expande;
        # usamos find para mover los ficheros de info realmente.
        find /var/lib/dpkg/info -maxdepth 1 -name "${packagename}.*" -exec mv {} /tmp/ \; 2>/dev/null
        wait_while_locked; dpkg --purge --force-all "$packagename"
        wait_while_locked
        if ! is_cloud_kernel "$packagename" || is_running_kernel_pkg "$packagename"; then
           if ! run_aptitude -y install "$packagename"; then
              wait_while_locked; dpkg --purge --force-all "$packagename"
           fi
        else
           echo "Paquete $packagename es un kernel de nube/GPU: no se reinstala."
        fi
     done
  fi

  # Desinstalamos paquetes en estado de inconsistencia
  wait_while_locked; inconsistent_packages=$(dpkg -l | awk '/^iU/ {print $2}')
  if [ -n "$inconsistent_packages" ]; then
     echo -e "${GREEN}Tratando de reparar paquetes en estado ^iU.${NC}"

     for packagename in $inconsistent_packages; do
        find /var/lib/dpkg/info -maxdepth 1 -name "${packagename}.*" -exec mv {} /tmp/ \; 2>/dev/null
        wait_while_locked; dpkg --remove --force-remove-reinstreq "$packagename"
     done
  fi

  # Reinstalamos paquetes a medio instalar o los desinstalamos si no se pueden reinstalar
  wait_while_locked; bad_packages=$(dpkg -l | awk '/^(iF|ri)/ {print $2}')
  if [ -n "$bad_packages" ]; then
     echo -e "${GREEN}Tratando de reinstalar paquetes en estado ^iF o ^ri.${NC}"
     # shellcheck disable=SC2086
     wait_while_locked; run_aptitude -y install $bad_packages
     wait_while_locked; bad_packages=$(dpkg -l | awk '/^(iF|ri)/ {print $2}')
     if [ -n "$bad_packages" ]; then
        wait_while_locked
        # shellcheck disable=SC2086
        if ! apt-get remove -y $bad_packages; then
           wait_while_locked
           # shellcheck disable=SC2086
           dpkg --purge --force-all $bad_packages
        fi
     fi
  fi

  wait_while_locked; apt-get check 1>/dev/null 2>/tmp/apterrors

  if [ -s /tmp/apterrors ]; then
     if grep -q 'Unable to acquire the dpkg frontend lock' /tmp/apterrors; then
        pgrep aptitude >/dev/null && killprocess aptitude "$AFTER_TIMEOUT"
        pgrep apt-get  >/dev/null && killprocess apt-get  "$AFTER_TIMEOUT"
        pgrep dpkg     >/dev/null && killprocess dpkg     "$AFTER_TIMEOUT"
     fi

     if grep -q "Unmet dependencies." /tmp/apterrors; then
        wait_while_locked; dpkg --configure -a
        wait_while_locked; apt-get -f install -y
     fi

     if grep -q "dpkg was interrupted" /tmp/apterrors; then
        wait_while_locked; dpkg --configure -a
        wait_while_locked; apt-get -f install -y
     fi

     if grep -qE 'Encountered a section with no Package: header|Problem with MergeList ' /tmp/apterrors; then
        rm -rf /var/lib/apt/lists/* 2>/dev/null || true
        wait_while_locked; check_apt_update
        wait_while_locked; dpkg --configure -a
        wait_while_locked; apt-get -f install -y
     fi
  fi

  # Reinstalamos paquetes con ficheros .list faltantes
  reinstall_broken_dpkg

  # Aseguramos la actualización de pkgsync
  wait_while_locked
  if apt list --upgradable 2>/dev/null | grep -q '^pkgsync/'; then
     run_aptitude -y install pkgsync
  fi

  # Restauramos el idioma original (sin exportar un valor vacío si no existía)
  if [ -n "$idioma" ]; then
     export LC_ALL="$idioma"
  else
     unset LC_ALL
  fi
  set -e
}

ensure_kernels() {
  if [ "$PURGE_OLD_KERNELS" = "yes" ]; then
     echo "APT::NeverAutoRemove::KernelCount \"$KEEP_LAST_KERNELS\";" > /etc/apt/apt.conf.d/99kernel-count

     # Excluir los kernels de nube del conteo antes de decidir si hay demasiados
     NUM_INSTALLED_KERNELS=$(find /boot -name "vmlinuz-*" | sed -e "s/^\/boot\/vmlinuz-//" | grep -Ev -- '-(aws|azure|gcp|oracle|nvidia|iotg|lowlatency|intel-iotg)$' | awk -F'[.-]' '{print $1"\t"$2"\t"$3"\t"$4"\t"$0}' | sort -k1 -k2 -k3 -k4 -n | cut -f5 | wc -l)

     if [[ "$NUM_INSTALLED_KERNELS" -gt "$KEEP_LAST_KERNELS" ]]; then
        # Eliminar kernels antiguos siempre y cuando se haya elegido esta opción y se encuentre /usr/local/sbin/purge-old-kernels
        if [ -x /usr/local/sbin/purge-old-kernels ]; then
           wait_while_locked; /usr/local/sbin/purge-old-kernels -s --keep "$KEEP_LAST_KERNELS" -qy
        fi
     fi
  fi
}

launchpad_getkeys() {
  # Obtener claves de repositorios siempre y cuando se haya elegido esta opción y se encuentre /usr/local/sbin/launchpad-getkeys
  local options=""

  if [ "$LAUNCHPAD_GETKEYS" = "yes" ] && [ -x /usr/local/sbin/launchpad-getkeys ]; then
     [ -n "$LAUNCHPAD_GETKEYS_PROXY" ] && options+=" -p $LAUNCHPAD_GETKEYS_PROXY"
     [ "$LAUNCHPAD_GETKEYS_REMOVE_EXPIRED_KEYS" = "yes" ] && options+=" -r"

     # shellcheck disable=SC2086
     /usr/local/sbin/launchpad-getkeys $options || true
  fi
}

eliminar_dependencias() {
  uninstalled_packages=$(dpkg -l | grep ^rc | awk '{print $2}')

  if [ -n "$uninstalled_packages" ]; then
     if [ "$CLEAN" = "yes" ]; then
        # Eliminar paquetes desinstalados
        # shellcheck disable=SC2086
        run_aptitude -y remove --purge-unused $uninstalled_packages
     elif [ "$CLEAN" = "purge" ]; then
        # Eliminar paquetes desinstalados y eliminar sus ficheros de configuración
        # shellcheck disable=SC2086
        run_aptitude -y purge $uninstalled_packages
     fi
  fi
  # Limpiar la cache de paquetes
  run_aptitude clean
}

apagar_equipo() {
  if [ "$SHUTDOWN" = true ] || [ "$AUTOSHUTDOWN" = true ]; then wait_while_locked; /sbin/poweroff; fi
}

reiniciar_equipo() {
  if [ "$REBOOT" = true ] || [ "$AUTOREBOOT" = true ]; then wait_while_locked; /sbin/reboot; fi
}

check_auto_shutdown() {
  local time horaini horafin
  time=$(date +%H%M)

  if [[ "$AUTOMATIC_SHUTDOWN_BETWEEN" =~ ^[0-9]{2}:[0-9]{2}-[0-9]{2}:[0-9]{2}$ ]]; then
     horaini="${AUTOMATIC_SHUTDOWN_BETWEEN:0:2}${AUTOMATIC_SHUTDOWN_BETWEEN:3:2}"
     horafin="${AUTOMATIC_SHUTDOWN_BETWEEN:6:2}${AUTOMATIC_SHUTDOWN_BETWEEN:9:2}"

     if (( 10#$horaini < 10#$horafin )); then
        if (( 10#$time >= 10#$horaini && 10#$time <= 10#$horafin )); then
           AUTOSHUTDOWN=true
        else
           AUTOSHUTDOWN=false
        fi
     elif (( 10#$horaini > 10#$horafin )); then
        if (( 10#$time >= 10#$horaini || 10#$time <= 10#$horafin )); then
           AUTOSHUTDOWN=true
        else
           AUTOSHUTDOWN=false
        fi
     fi
  fi
}

check_auto_reboot() {
  local time horaini horafin
  time=$(date +%H%M)

  if [[ "$AUTOMATIC_REBOOT_BETWEEN" =~ ^[0-9]{2}:[0-9]{2}-[0-9]{2}:[0-9]{2}$ ]]; then
     horaini="${AUTOMATIC_REBOOT_BETWEEN:0:2}${AUTOMATIC_REBOOT_BETWEEN:3:2}"
     horafin="${AUTOMATIC_REBOOT_BETWEEN:6:2}${AUTOMATIC_REBOOT_BETWEEN:9:2}"

     if (( 10#$horaini < 10#$horafin )); then
        if (( 10#$time >= 10#$horaini && 10#$time <= 10#$horafin )); then
           AUTOREBOOT=true
        else
           AUTOREBOOT=false
        fi
     elif (( 10#$horaini > 10#$horafin )); then
        if (( 10#$time >= 10#$horaini || 10#$time <= 10#$horafin )); then
           AUTOREBOOT=true
        else
           AUTOREBOOT=false
        fi
     fi
  fi

  if [ "$REBOOT" = true ] && [ "$AUTOMATIC_REBOOT_INTO_WINDOWS" = "yes" ] && command -v efibootmgr >/dev/null 2>&1; then
     local bootorder w10_bootnum
     # Obtenemos el orden de arranque actual
     bootorder=$(efibootmgr | sed -n 's|^BootOrder: \(.*\)|\1|p')

     if command -v gdisk >/dev/null 2>&1; then
        local DISK EFI_DISK EFIPART
        for DISK in $(lsblk --nodeps -ndo NAME,TYPE | awk '$2 == "disk" {print $1}'); do
           EFI_DISK="/dev/$DISK"
           EFIPART=$(gdisk -l "$EFI_DISK" 2>/dev/null | grep -w "EFI system partition" | awk '{print $1}' | head -n 1)

           # Creamos una entrada específica para Windows 10, si no está creada
           if [ -n "$EFIPART" ]; then
              EFIPART="${EFIPART%+}" # gdisk informa "1+" cuando lleva el sufijo
              efibootmgr | grep -q "W10IES" || efibootmgr -c -d "$EFI_DISK" -p "$EFIPART" -L "W10IES" -l "\EFI\Microsoft\Boot\bootmgfw.efi" >/dev/null 2>&1 || true
           fi
        done
     fi

     # Restauramos el bootorder
     [ -n "$bootorder" ] && efibootmgr -o "$bootorder" >/dev/null 2>&1 || true

     # Establecemos un arranque temporal de Windows
     w10_bootnum=$(efibootmgr | grep "W10IES" | cut -f1 -d" " | sed -e "s/^Boot//" -e "s/\*$//" | head -n 1)
     # shellcheck disable=SC2086
     [ -n "$w10_bootnum" ] && efibootmgr -n $w10_bootnum >/dev/null 2>&1 || true
  fi
}

upgrade_packages() {
  # Comprobar si hay paquetes para actualizar
  local UPGRADABLE
  UPGRADABLE=$(aptitude search '~U' || true)

  if [ -n "$UPGRADABLE" ]; then
    log_output_pkgsync echo -e "${GREEN}Se encontraron paquetes para actualizar:${NC}"
    log_output_pkgsync echo -e "${GREEN}$UPGRADABLE${NC}"
    log_output_pkgsync echo -e "${GREEN}Ejecutando 'aptitude upgrade'...${NC}"
    run_aptitude upgrade
  else
    log_output_pkgsync echo -e "${GREEN}No hay paquetes para actualizar.${NC}"
  fi
}


if (( $EUID != 0 )); then
   echo -e "${RED}Please run with SUDO or root user account${NC}"
   exit 1
fi

mkdir -p /var/log/pkgsync
:>/var/log/pkgsync.log

# Evitar múltiples ejecuciones simultáneas
LOCKFILE="/var/lock/$(basename "$0").lock"
SCRIPTNAME="$(basename "$0")"

exec 200>"$LOCKFILE"
flock -n 200 || {
    echo -e "${RED}[ERROR] '$SCRIPTNAME' ya está en ejecución (lock: $LOCKFILE)${NC}" >&2
    exit 2
}

cleanup() {
    if [ "${DISABLED_FAILED_REPOS:-false}" = true ]; then
        enable_repositories || true
        DISABLED_FAILED_REPOS=false
    fi
    flock -u 200 2>/dev/null || true
    rm -f "$LOCKFILE"
}

trap cleanup EXIT
############################################

# Establecemos valores por defecto
ENABLE=yes # Controlamos la ejecución manual o automática de pkgsync
HELP=false
FORCE=false
SHUTDOWN=false # No apagar
REBOOT=false   # No reiniciar
AUTOSHUTDOWN=false # No apagar
AUTOREBOOT=false   # No reiniciar
PURGE_OLD_KERNELS="no"
KEEP_LAST_KERNELS="2"
CLEAN="no"
PUPPET_SERVER=puppetinstituto
AUTOMATIC_SHUTDOWN_BETWEEN=""
AUTOMATIC_REBOOT_BETWEEN=""
AUTOMATIC_REBOOT_INTO_WINDOWS=no
LAUNCHPAD_GETKEYS=yes
LAUNCHPAD_GETKEYS_PROXY=""
LAUNCHPAD_GETKEYS_REMOVE_EXPIRED_KEYS=no
TIMEOUT_FOR_SINC_PUPPET="5"
TIMEOUT_FOR_DPKG_OR_APT="3m"
TIMEOUT_FOR_MUSTHAVE_BUILD="2m"
THRESHOLD_FOR_APT_UPDATE=$((30 * 60)) # Umbral en segundos (30 minutos por defecto)
ABORT_ON_FAILED_REPOS="yes"
DISABLED_FAILED_REPOS=false
AUTO_TEST_FILES="no"
ALERT_EMAIL_RECEIVER=""
ALERT_EMAIL_ON_ERROR="no"
ENSURE_ESSENTIAL="no"
IGNORE_MUSTHAVE="no"
IGNORE_MAYNOTHAVE="no"
IGNORE_MAYHAVE="no"
SIMULATE="no"
rest_markauto=""
runned_sinc_puppet=false

LAUNCH_SINC_PUPPET=yes

[ -r /etc/default/pkgsync ] && . /etc/default/pkgsync

[ -x /usr/sbin/sinc_puppet ] || LAUNCH_SINC_PUPPET="no"

# Calculamos AFTER_TIMEOUT en segundos a partir de TIMEOUT_FOR_DPKG_OR_APT,
# que wait_while_locked necesita (timeout solo admite segundos)
[ -n "$TIMEOUT_FOR_DPKG_OR_APT" ] || TIMEOUT_FOR_DPKG_OR_APT="3m"
TIMEOUT_UNITS=${TIMEOUT_FOR_DPKG_OR_APT: -1}
TIMEOUT_NUMBER=${TIMEOUT_FOR_DPKG_OR_APT:: -1}
case "$TIMEOUT_UNITS" in
   "s")  AFTER_TIMEOUT=$TIMEOUT_NUMBER ;;
   "m")  AFTER_TIMEOUT=$((TIMEOUT_NUMBER * 60)) ;;
   "h")  AFTER_TIMEOUT=$((TIMEOUT_NUMBER * 3600)) ;;
   "d")  AFTER_TIMEOUT=$((TIMEOUT_NUMBER * 86400)) ;;
   *)    AFTER_TIMEOUT=180 ;;
esac

parse_options "$@"

if [ "$FORCE" = true ]; then ENABLE=yes; fi
if [ "$ENABLE" == "no" ] || [ ! "$ENABLE" ]; then
  echo " * [info]: La aplicación 'pkgsync' está desactivada en /etc/default/pkgsync."
  echo "           Para activarla poner el valor ENABLE=yes."
  exit 0
fi

# Crear el directorio /etc/pkgsync y sus subdirectorios si no existen
if [ ! -d /etc/pkgsync/mayhave.d ]; then
   echo -e "${GREEN}Creando el directorio /etc/pkgsync/mayhave.d/ ...${NC}"
   mkdir -p /etc/pkgsync/mayhave.d
fi

if [ ! -d /etc/pkgsync/maynothave.d ]; then
   echo -e "${GREEN}Creando el directorio /etc/pkgsync/maynothave.d/ ...${NC}"
   mkdir -p /etc/pkgsync/maynothave.d
fi

if [ ! -d /etc/pkgsync/musthave.d ]; then
   echo -e "${GREEN}Creando el directorio /etc/pkgsync/musthave.d/ ...${NC}"
   mkdir -p /etc/pkgsync/musthave.d
fi

# Crear ficheros auxiliares vacíos si no existen
for _f in /etc/pkgsync/mayhave /etc/pkgsync/mayhave.ies \
          /etc/pkgsync/maynothave /etc/pkgsync/maynothave.ies \
          /etc/pkgsync/musthave.ies /etc/pkgsync/musthave.orphan; do
   if [ ! -r "$_f" ]; then
      echo -e "${GREEN}Creando el fichero $_f ...${NC}"
      touch "$_f"
   fi
done
unset _f

# Generar /etc/pkgsync/musthave si no existe el fichero con la lista de paquetes instalados en el sistema o está vacío
if [ ! -r /etc/pkgsync/musthave -o ! -s /etc/pkgsync/musthave ]; then
   timeout "$TIMEOUT_FOR_MUSTHAVE_BUILD" /usr/local/sbin/musthave-build

   # Si no se ha creado un fichero musthave, mostramos un error
   if [ ! -r /etc/pkgsync/musthave ]; then
      echo -e "${RED}Error: Fichero musthave no encontrado en /etc/pkgsync. Abortando.${NC}"
      echo
      echo "Please see /usr/share/doc/pkgsync/README.Debian for information on"
      echo "configuring pkgsync."

      exit 1
   fi
fi

# Check if we've got debtags installed
[ -x /usr/bin/debtags ] && USE_DEBTAGS=yes

if [ "$IGNORE_MUSTHAVE" = "yes" ]; then
   MUSTHAVE=""
else
   MUSTHAVE="/etc/pkgsync/musthave"
fi

if [ "$IGNORE_MAYNOTHAVE" = "yes" ]; then
   MAYNOTHAVE=""
else
   MAYNOTHAVE="/etc/pkgsync/maynothave"
fi

if [ "$IGNORE_MAYHAVE" = "yes" ]; then
   MAYHAVE=""
else
   MAYHAVE="/etc/pkgsync/mayhave"
fi

if [ "$SIMULATE" = "yes" ]; then
   simulate
   exit 0
fi

# Determinar si se debe apagar el equipo al terminar
check_auto_shutdown

# Determinar si se debe reiniciar el equipo al terminar
check_auto_reboot

# Descargar claves de repositorios
log_output_pkgsync launchpad_getkeys

# Reparamos posibles errores previos de apt/dpkg
solveapterrors

echo -e "${CYAN}Comprobando si existen actualizaciones de paquetes instalados...${NC}"
:> /tmp/failedrepositories
:> /tmp/apt_update.log
wait_while_locked; check_apt_update

if [ -s /tmp/failedrepositories ] || grep -qw '^W: Failed to fetch' /tmp/apt_update.log 2>/dev/null; then
   if [ "$ABORT_ON_FAILED_REPOS" = "yes" ]; then
      log_output_pkgsync echo -e "${RED}\n[ERR] aptitude update error. Mirror sync in progress?${NC}"
      if [ -s /tmp/failedrepositories ]; then
         log_output_pkgsync echo "The following repositories fail:"
         log_output_pkgsync cat /tmp/failedrepositories
      fi
      echo -e "${RED}      Aborting${NC}"
      exit 1
   elif [ "$ABORT_ON_FAILED_REPOS" = "no" ]; then
      disable_failed_repositories
      DISABLED_FAILED_REPOS=true
   fi
fi

# Upgrade software
upgrade_packages

if [ -x /usr/sbin/sinc_puppet ]; then

   wait_for_sinc_puppet "$TIMEOUT_FOR_SINC_PUPPET" || true

   # Si el servidor puppet responde, se encuentra el ejecutable de sinc_puppet, y no ha sido iniciado previamente, lo iniciamos
   if [ -n "$PUPPET_SERVER" ] && ping -c1 "$PUPPET_SERVER" > /dev/null 2>&1; then
      if [ "$runned_sinc_puppet" = false ]; then
         installed_version=$(dpkg -s linex-ubuntu-puppet 2>/dev/null | grep 'Version:' | cut -f2 -d" " || true)
         if [ -n "$installed_version" ] && version_ge "$installed_version" "2.7"; then
            if [ "$LAUNCH_SINC_PUPPET" = "yes" ] && [ -x /usr/sbin/sinc_puppet ]; then log_output_pkgsync /usr/sbin/sinc_puppet -f now; fi
         else
            if [ "$LAUNCH_SINC_PUPPET" = "yes" ] && [ -x /usr/sbin/sinc_puppet ]; then log_output_pkgsync /usr/sbin/sinc_puppet -f; fi
         fi
      fi
   fi
fi

echo -e "${GREEN}Realizando pkgsync...${NC}"

# Update the package lists if cache expired (e.g. after sinc_puppet modified sources)
wait_while_locked; check_apt_update

if [ -s /tmp/failedrepositories ]; then
   if [ "$ABORT_ON_FAILED_REPOS" = "yes" ]; then
      # Abortamos pkgsync si algún repositorio no se encuentra accesible
      log_output_pkgsync echo -e "${RED}\n[ERR] aptitude update error${NC}"
      log_output_pkgsync echo "The following repositories fail:"
      log_output_pkgsync cat /tmp/failedrepositories
      echo -e "${RED}      Aborting${NC}"
      exit 1
   elif [ "$ABORT_ON_FAILED_REPOS" = "no" ]; then
      disable_failed_repositories
      DISABLED_FAILED_REPOS=true
   fi
fi

run_debtags update

# Si el valor de ENABLE es onlyupgrade, entonces tratamos de resolver errores de apt, actualizamos paquetes y finalizamos
if [ "$ENABLE" = "onlyupgrade" ]; then
   exit 0
fi

if [ "$AUTO_TEST_FILES" = "yes" ]; then
   test_files; remove_packages_from_lists
fi

# Merge files
merge_files

# Find out what parameters to give to aptitude.
installed=$( dpkg -l | grep '^ii' | cut -c5- | cut '-d ' -f1 )
musthave_install=$( getpkgs /etc/pkgsync/musthave.all | sort -u | sed "s/$/+/" )
maynothave_remove=$( getpkgs /etc/pkgsync/maynothave.all | sort -u | sed "s/$/-/" )
mayhave_marknonauto=$( getpkgs /etc/pkgsync/mayhave.all | sort -u | sed "s/$/\&m/" )
mustormayhave=$( ( getpkgs /etc/pkgsync/musthave.all ; getpkgs /etc/pkgsync/mayhave.all ) | sort -u )

if [ "$IGNORE_MUSTHAVE" = "no" ]; then
 # shellcheck disable=SC2086
 rest_markauto=$( filter $installed $installed $mustormayhave | sed "s/$/\&M/" )
fi

# shellcheck disable=SC2086
log_output_pkgsync run_aptitude full-upgrade '?upgradable' $musthave_install $maynothave_remove $mayhave_marknonauto $rest_markauto

pkgs=$(find /etc/pkgsync/musthave /etc/pkgsync/musthave.ies /etc/pkgsync/musthave.d -type f -exec grep -h -w -F -f <(dpkg -l | awk '/^rc/ {print $2}') {} + 2>/dev/null | grep -v -w -F -f <(find /etc/pkgsync/maynothave /etc/pkgsync/maynothave.ies /etc/pkgsync/maynothave.d -type f -exec cat {} + 2>/dev/null | grep -E -v '^\s*($|#)') | sort -u || true)

if [ -n "$pkgs" ]; then
    echo "Se han encontrado paquetes en estado rc que deberían estar instalados:"
    echo "$pkgs"
    echo "Ejecutando nuevamente pkgsync"
    # shellcheck disable=SC2086
    log_output_pkgsync run_aptitude full-upgrade '?upgradable' $musthave_install $maynothave_remove $mayhave_marknonauto $rest_markauto
fi

log_output_pkgsync run_aptitude autoclean
log_output_pkgsync ensure_kernels
log_output_pkgsync eliminar_dependencias
log_output_pkgsync echo -e "${GREEN}Proceso concluido.${NC}"

if [ "$ABORT_ON_FAILED_REPOS" = "no" ] && [ "$DISABLED_FAILED_REPOS" = true ]; then
   enable_repositories
   DISABLED_FAILED_REPOS=false
fi

if [ "$ALERT_EMAIL_ON_ERROR" = "yes" ] && [ -n "$ALERT_EMAIL_RECEIVER" ]; then
   if grep -Eq '(\[ERR\]|^Err:|E: )' /var/log/pkgsync.log 2>/dev/null; then
      mail -s "Error al ejecutar pkgsync en el equipo $(hostname)" "$ALERT_EMAIL_RECEIVER" < /var/log/pkgsync.log || true
   fi
fi

# El lock se libera automáticamente al salir mediante el trap cleanup EXIT

apagar_equipo
reiniciar_equipo