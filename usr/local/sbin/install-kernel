#!/bin/bash
# ------------------------------------------------------------
# script:  /usr/local/sbin/install-kernel
# Author:  Esteban M. Navas Martín
# Date:    21-11-2026
# Ver:     1.6
#
# Purpose: List available installable kernels (generic or proxmox),
#          show installed ones, and allow installation
#
# Cambios 1.6:
#   - No se aborta si linux-modules-extra / linux-headers no existen
#     para la serie elegida (p. ej. kernels 7.0): se avisa y se
#     instala lo que haya disponible, previa comprobación con
#     apt-cache policy.
#   - Validación numérica de la selección y de la confirmación.
#   - Detección de kernel instalado consistente (grep -F -qx).
#   - Instalación con apt-get directamente si se es root.

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
NC='\033[0m'

# Comprobar disponibilidad de un paquete en los repositorios
pkg_available() {
   local candidate
   candidate=$(LC_ALL=C apt-cache policy "$1" 2>/dev/null | awk '/^  Candidate:/ {print $2}')
   [ -n "$candidate" ] && [ "$candidate" != "(none)" ]
}

# Comando apt: sin sudo si ya somos root
if [ "$(id -u)" -eq 0 ]; then
   APT="apt-get"
else
   APT="sudo apt-get"
fi

echo "Obteniendo la lista de kernels instalables (generic y proxmox)..."

# Obtener los kernels disponibles que sean generic o proxmox
available_kernels=$(apt-cache search --names-only '^linux-image-[0-9]+\.[0-9]+\.[0-9]+.*' 2>/dev/null | grep -E '(generic|proxmox)' | awk '{print $1}')

# Obtener los kernels actualmente instalados
installed_kernels=$(dpkg --list | grep -E "^ii\s+(linux-image|proxmox-kernel)-[0-9]" | awk '{print $2}')

# Verificar si hay kernels disponibles
if [[ -z "$available_kernels" ]]; then
    echo -e "${RED}No se encontraron kernels 'generic' o 'proxmox' disponibles para instalación.${NC}"
    exit 1
fi

# Ordenar los kernels por versión y separarlos por series
sorted_kernels=$(echo "$available_kernels" | sed -E 's/.*-([0-9]+\.[0-9]+)\.[0-9]+.*/\1 \0/' | sort -k1,1V -k2,2V)
series=""

# Mostrar la lista de kernels ordenada y separada por series
echo -e "${GREEN}Kernels disponibles para instalar:${NC}"
options=()
i=1

while read -r line; do
    current_series=$(echo "$line" | awk '{print $1}')
    kernel=$(echo "$line" | awk '{print $2}')

    if [[ "$current_series" != "$series" ]]; then
        # Nueva serie detectada, mostrar encabezado
        series="$current_series"
        echo -e "\n${YELLOW}Serie $series:${NC}"
    fi

    # Verificar si el kernel está instalado
    if echo "$installed_kernels" | grep -F -qx "$kernel"; then
        echo -e "  $i) ${BLUE}$kernel (INSTALADO)${NC}"
    else
        echo "  $i) $kernel"
    fi

    # Agregar el kernel a las opciones
    options+=("$kernel")
    i=$((i + 1))
done <<< "$sorted_kernels"

# Pedir al usuario que seleccione un kernel
echo -e "\nSeleccione un kernel para instalar:"
read -p "Ingrese el número correspondiente (o 0 para cancelar): " selection

# Validar la selección
if [[ "$selection" == "0" ]]; then
    echo "Operación cancelada."
    exit 0
elif ! [[ "$selection" =~ ^[0-9]+$ ]] || [[ "$selection" -lt 1 || "$selection" -gt ${#options[@]} ]]; then
    echo -e "${RED}Selección inválida.${NC}"
    exit 1
fi

# Obtener el kernel seleccionado
selected_kernel="${options[$((selection - 1))]}"
echo -e "${YELLOW}Ha seleccionado el kernel: $selected_kernel${NC}"

# Verificar si el kernel ya está instalado
if echo "$installed_kernels" | grep -F -qx "$selected_kernel"; then
    echo -e "${BLUE}El kernel $selected_kernel ya está instalado.${NC}"
    exit 0
fi

# Determinar el tipo de kernel y preparar la lista de paquetes a instalar,
# comprobando AVAILABILITY de cada paquete extra antes de añadirlo
packages_to_install=("$selected_kernel")
if [[ "$selected_kernel" == *generic* ]]; then
    # Extraer la versión del kernel
    kernel_version=$(echo "$selected_kernel" | sed -E 's/^[^0-9]*([0-9]+\.[0-9]+\.[0-9]+-[0-9]+).*/\1/')

    echo "KERNEL VERSION: $kernel_version"

    for extra in "linux-headers-$kernel_version-generic" "linux-modules-extra-$kernel_version-generic"; do
        if pkg_available "$extra"; then
            packages_to_install+=("$extra")
        else
            echo -e "${YELLOW}Aviso: $extra no está disponible en los repositorios; se continúa sin él.${NC}"
        fi
    done
fi

# Verificación final: todos los paquetes de la lista deben existir
for pkg in "${packages_to_install[@]}"; do
    if ! pkg_available "$pkg"; then
        echo -e "${RED}Error: el paquete $pkg no existe en los repositorios. Abortando.${NC}"
        exit 1
    fi
done

# Confirmar la instalación
echo -e "${GREEN}Los siguientes paquetes se instalarán:${NC}"
for pkg in "${packages_to_install[@]}"; do
    echo "  - $pkg"
done

read -p "¿Desea proceder con la instalación? (s/N): " confirm
if [[ "$confirm" =~ ^[sS]$ ]]; then
    echo -e "${GREEN}Instalando paquetes seleccionados...${NC}"
    if $APT install -y "${packages_to_install[@]}"; then
        echo -e "${GREEN}La instalación se completó correctamente.${NC}"
        echo -e "${BLUE}Recuerde: el nuevo kernel se usará tras reiniciar.${NC}"
    else
        echo -e "${RED}Hubo un error durante la instalación.${NC}"
        exit 1
    fi
else
    echo "Operación cancelada."
fi