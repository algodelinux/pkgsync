#!/usr/bin/env bash
# -------------------------------------------------------------------------------------------
# script: install-last-available-kernels
# Author: Esteban M. Navas Martín
# Date:   09-02-2024
# Ver:    05-10-2026
#
# Purpose: Install the latest N available kernels and remove the excess ones
#          to maintain a total number of N kernels on the system.
# -------------------------------------------------------------------------------------------

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

is_installed() {
    dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "install ok installed"
}

# Comprobaciones iniciales (permisos y parámetros)
if (( EUID != 0 )); then
   echo -e "${RED}Error: Por favor, ejecute el script con SUDO o como usuario root.${NC}"
   exit 1
fi

if [[ -z "${1:-}" ]] || ! [[ "$1" =~ ^[0-9]+$ ]]; then
    echo -e "${RED}Error: Debe especificar un número entero válido de kernels a mantener.${NC}"
    echo -e "${GREEN}Sintaxis: $0 <numero-de-kernels>${NC}"
    exit 1
fi

numkernels="$1"
CURRENT_KERNEL_VER="$(uname -r)"
KERNEL_FLAVOR="$(echo "$CURRENT_KERNEL_VER" | cut -d'.' -f1,2)"

# Obtener los N últimos kernels disponibles en los repositorios
AVAILABLE_KERNELS=$(
    apt-cache search "linux-image-$KERNEL_FLAVOR" \
    | grep generic \
    | sort -V \
    | tail -n "$numkernels" \
    | awk '{print $1}' \
    | sed 's/linux-image-//'
)

INSTALLED_NEW_IMAGE=false

# Instalación de los N últimos kernels
PACKAGES_TO_INSTALL=()
INSTALLED_NEW_IMAGE=false

for KERNEL_VERSION in $AVAILABLE_KERNELS; do
    for PACKAGE_NAME in linux-image linux-headers linux-modules linux-modules-extra; do
        FULLPACKAGENAME="$PACKAGE_NAME-$KERNEL_VERSION"

        # Verificar disponibilidad en repositorio antes de añadirlo
        if apt-cache show "$FULLPACKAGENAME" &>/dev/null; then
            if ! is_installed "$FULLPACKAGENAME"; then
                PACKAGES_TO_INSTALL+=("$FULLPACKAGENAME")

                if [[ "$PACKAGE_NAME" == "linux-image" ]]; then
                    INSTALLED_NEW_IMAGE=true
                fi
            fi
        fi
    done
done

# Instalar todos los paquetes de una sola vez
if ((${#PACKAGES_TO_INSTALL[@]} > 0)); then
    echo -e "${GREEN}Instalando paquetes del kernel:${NC}"
    printf '  %s\n' "${PACKAGES_TO_INSTALL[@]}"

    apt-get -y install "${PACKAGES_TO_INSTALL[@]}"
fi

# Purgado de kernels antiguos sobrantes (si el total excede N)
INSTALLED_IMAGE_PACKAGES=$(dpkg-query -W -f='${Package}\t${Status}\n' 'linux-image-[0-9]*' 2>/dev/null \
    | grep "install ok installed" \
    | awk '{print $1}' \
    | sort -V)

NUM_INSTALLED=$(echo "$INSTALLED_IMAGE_PACKAGES" | sed '/^$/d' | wc -l)

if (( NUM_INSTALLED > numkernels )); then
    EXTRA_COUNT=$(( NUM_INSTALLED - numkernels ))
    echo -e "${YELLOW}Se detectaron $NUM_INSTALLED kernels instalados. Se mantendrán solo los $numkernels más recientes.${NC}"

    CANDIDATES_TO_REMOVE=$(echo "$INSTALLED_IMAGE_PACKAGES" | head -n "$EXTRA_COUNT")
    PACKAGES_TO_PURGE=""

    for IMG_PKG in $CANDIDATES_TO_REMOVE; do
        VERSION_TO_REMOVE="${IMG_PKG#linux-image-}"

        # Seguridad: NUNCA eliminar el kernel actualmente activo en el sistema
        if [[ "$VERSION_TO_REMOVE" == "$CURRENT_KERNEL_VER" ]]; then
            echo -e "${YELLOW}Aviso: Se omite $IMG_PKG por estar actualmente en uso ($CURRENT_KERNEL_VER).${NC}"
            continue
        fi

        for PKG_PREFIX in linux-image linux-headers linux-modules linux-modules-extra; do
            TARGET_PKG="$PKG_PREFIX-$VERSION_TO_REMOVE"
            if is_installed "$TARGET_PKG"; then
                PACKAGES_TO_PURGE="$PACKAGES_TO_PURGE $TARGET_PKG"
            fi
        done
    done

    if [[ -n "$PACKAGES_TO_PURGE" ]]; then
        echo -e "${GREEN}Eliminando paquetes sobrantes:${NC}$PACKAGES_TO_PURGE"
        apt-get purge -y $PACKAGES_TO_PURGE
        apt-get autoremove --purge -y
    fi
fi

# Reordenación de kernels en caso de haber instalado una nueva imagen
if [[ "$INSTALLED_NEW_IMAGE" == true ]]; then
    echo
    echo -e "${GREEN}Se ha instalado un nuevo kernel. Ejecutando reorder-kernels...${NC}"
    if [[ -x /usr/local/sbin/reorder-kernels ]]; then
        /usr/local/sbin/reorder-kernels
    else
        echo -e "${YELLOW}Aviso: /usr/local/sbin/reorder-kernels no existe o no tiene permisos de ejecución.${NC}"
    fi
fi
